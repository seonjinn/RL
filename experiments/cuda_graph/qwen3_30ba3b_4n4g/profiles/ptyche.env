# Ptyche Qwen3-30B-A3B profile. Reuse the validated latest-main container and
# MCore runtime while pinning model and tokenizer to one complete HF snapshot.
PROFILE_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "${PROFILE_DIR}/../../latestmain_nanov3/profiles/ptyche.env"

QWEN3_30BA3B_SNAPSHOT=/lustre/fsw/coreai_dlalgo_llm/users/sna/hf_home/hub/models--Qwen--Qwen3-30B-A3B/snapshots/ad44e777bcd18fa416d9da3bd8f70d33ebb85d39

# The official policy topology uses 4x4 GPUs. TE training graphs require
# non-colocated generation, so the allocation includes another 4x4 GPUs.
NUM_ACTOR_NODES=8
INFERENCE_NODES=4
GPUS_PER_NODE=4
SEGMENT_SIZE=4
TIME_LIMIT=04:00:00
