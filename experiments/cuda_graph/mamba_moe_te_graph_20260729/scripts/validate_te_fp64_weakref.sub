#!/usr/bin/env bash
#SBATCH --nodes=1
#SBATCH --account=coreai_dlalgo_llm
#SBATCH --job-name=coreai_dlalgo_llm-sna.te-fp64-weakref
#SBATCH --partition=batch
#SBATCH --time=00:30:00
#SBATCH --segment=1
#SBATCH --output=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg/exp_logs/mamba_moe_te_graph_20260729/te-fp64-weakref/validate-%j.out
#SBATCH --error=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg/exp_logs/mamba_moe_te_graph_20260729/te-fp64-weakref/validate-%j.err

set -euo pipefail

ROOT=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg
IMAGE=${ROOT}/containers/nemo_rl_nightly_20260729_2472184.sqsh
PYTHON=/opt/nemo_rl_venv/bin/python3
TE_ARCHIVE=/root/.cache/uv/archive-v0/AdbVCNRp6JVFPo0e
FLASH_ATTN_ARCHIVE=/root/.cache/uv/archive-v0/26H_iFoUOK00pyG5
ML_DTYPES_ARCHIVE=/root/.cache/uv/archive-v0/ymbKBYrUysuiERDQ
ONNX_ARCHIVE=/root/.cache/uv/archive-v0/Lp_mVBWGrC-sLPL6
ONNX_IR_ARCHIVE=/root/.cache/uv/archive-v0/kIpfdwf26Al4-BTb
ONNXSCRIPT_ARCHIVE=/root/.cache/uv/archive-v0/i7-d_jifMXRoKKrY
TE_OVERLAY_TARGET=/root/.cache/uv/archive-v0/AdbVCNRp6JVFPo0e/transformer_engine/pytorch/utils.py

: "${TE_SOURCE_ROOT:?Submit with the shared Transformer Engine source root}"
: "${TE_OVERLAY_ENABLED:=0}"

case "${TE_OVERLAY_ENABLED}" in
    0 | 1) ;;
    *)
        echo "TE_OVERLAY_ENABLED must be 0 or 1, got ${TE_OVERLAY_ENABLED}" >&2
        exit 2
        ;;
esac

test -f "${IMAGE}"
test -f "${TE_SOURCE_ROOT}/tests/pytorch/test_cuda_graphs.py"
test -x "${PYTHON}"

CONTAINER_MOUNTS=/lustre:/lustre
if [[ "${TE_OVERLAY_ENABLED}" == "1" ]]; then
    test -f "${TE_SOURCE_ROOT}/transformer_engine/pytorch/utils.py"
    CONTAINER_MOUNTS+=",${TE_SOURCE_ROOT}/transformer_engine/pytorch/utils.py:${TE_OVERLAY_TARGET}:ro"
fi

PYTHONPATH="${TE_ARCHIVE}:${FLASH_ATTN_ARCHIVE}:${ML_DTYPES_ARCHIVE}:${ONNX_ARCHIVE}:${ONNX_IR_ARCHIVE}:${ONNXSCRIPT_ARCHIVE}"

srun --nodes=1 --ntasks=1 \
    --container-image="${IMAGE}" \
    --container-mounts="${CONTAINER_MOUNTS}" \
    --export="ALL,CUDA_VISIBLE_DEVICES=0,PYTHONPATH=${PYTHONPATH}" \
    "${PYTHON}" - "${TE_SOURCE_ROOT}/tests/pytorch/test_cuda_graphs.py" <<'PY'
import importlib
import os
from pathlib import Path
import sys

import pytest
import transformer_engine
import transformer_engine.pytorch
import transformer_engine.pytorch.utils as te_utils

test_file = sys.argv[1]
expected_python = "/opt/nemo_rl_venv/bin/python3"
expected_utils = "/root/.cache/uv/archive-v0/AdbVCNRp6JVFPo0e/transformer_engine/pytorch/utils.py"
expected_native_root = "/root/.cache/uv/archive-v0/AdbVCNRp6JVFPo0e/transformer_engine"

assert sys.executable == expected_python
assert transformer_engine.__version__ == "2.15.0+42b84005"
assert os.path.realpath(te_utils.__file__) == expected_utils
native = importlib.import_module("transformer_engine_torch")
assert Path(native.__file__).resolve().is_relative_to(expected_native_root)

print(f"python={sys.executable}")
print(f"te_version={transformer_engine.__version__}")
print(f"te_utils={os.path.realpath(te_utils.__file__)}")
print(f"te_native={Path(native.__file__).resolve()}")

raise SystemExit(pytest.main(["-vv", test_file, "-k", "fp64"]))
PY
