#!/usr/bin/env bash
#SBATCH --nodes=1
#SBATCH --account=coreai_dlalgo_llm
#SBATCH --job-name=coreai_dlalgo_llm-sna-cg-study.nemorl-integration
#SBATCH --partition=backfill
#SBATCH --time=01:00:00
#SBATCH --segment=1
#SBATCH --output=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg/logs/nemorl-integration-%j.out

set -euo pipefail

ROOT=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg
REPO=${ROOT}/src/RL-pr5672-mamba-moe-graph-cache-20260729-d7f1d496f
IMAGE=${CONTAINER:-${ROOT}/containers/nemo_rl_nightly_20260729_2472184.sqsh}
TE_FP64_WEAKREF_SOURCE=${ROOT}/src/TransformerEngine-fp64-weakref-20260729/.overlay/e707aa46869dc2aec08dfea25402e97a61d49fef/utils.py
TE_FP64_WEAKREF_TARGET=/root/.cache/uv/archive-v0/AdbVCNRp6JVFPo0e/transformer_engine/pytorch/utils.py
TE_FP64_WEAKREF_SHA256=39f7b26b8cf127e3ca104c0375c97ce4e6d047178f9d00836b92469b1c2e544b
TE_EXPECTED_VERSION=2.15.0+42b84005
: "${EXPECTED_SHA:?Submit with the immutable NeMo-RL commit SHA}"
mkdir -p "${ROOT}/uv_cache"
test -f "${TE_FP64_WEAKREF_SOURCE}"

srun --nodes=1 --ntasks=1 \
  --container-image="${IMAGE}" \
  --container-mounts=/lustre:/lustre,${TE_FP64_WEAKREF_SOURCE}:${TE_FP64_WEAKREF_TARGET}:ro \
  bash -lc "
    set -euo pipefail
    cd ${REPO}
    test \"\$(git rev-parse HEAD)\" = ${EXPECTED_SHA}
    git diff --quiet --ignore-submodules=dirty -- . ':(exclude)uv.lock'
    git diff --cached --quiet
    git ls-files --others --exclude-standard | while IFS= read -r untracked_path; do
      case \"\${untracked_path}\" in
        tests/unit/unit_results.json) ;;
        *)
          if [[ ! \"\${untracked_path}\" =~ ^tests/unit/unit_results/[^/]+\.json$ ]]; then
            echo \"Unexpected untracked path: \${untracked_path}\" >&2
            exit 1
          fi
          ;;
      esac
    done
    export PYTHONPATH=\${PWD}:\${PWD}/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge/src:\${PWD}/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge/3rdparty/Megatron-LM
    export UV_CACHE_DIR=${ROOT}/uv_cache
    export NVTE_CUDA_ARCHS=100
    /opt/nemo_rl_venv/bin/python experiments/cuda_graph/mamba_moe_te_graph_20260729/run_pytest_with_te_overlay.py --expected-version ${TE_EXPECTED_VERSION} --expected-sha256 ${TE_FP64_WEAKREF_SHA256} -- \
      -q \
      tests/unit/models/megatron/test_cuda_graph_lifecycle.py \
      tests/unit/data/packing/test_algorithms.py \
      tests/unit/models/megatron/test_megatron_data.py \
      tests/unit/models/megatron/test_megatron_setup.py \
      tests/unit/models/policy/test_megatron_worker.py \
      tests/unit/experiments/test_mamba_moe_te_graph_launchers.py \
      tests/unit/models/megatron/test_train.py::TestForwardWithPostProcessingFn::test_forward_with_loss_post_processor \
      tests/unit/models/megatron/test_train.py::TestLossPostProcessor::test_loss_post_processor_uses_actual_boundaries_with_graph_sentinels \
      tests/unit/models/megatron/test_train.py::TestLossPostProcessor::test_fused_loss_uses_actual_boundaries_with_graph_sentinels \
      tests/unit/utils/test_venvs.py::test_create_local_venv_passes_shared_uv_environment_to_every_command \
      tests/unit/utils/test_venvs.py::test_create_local_venv_preserves_uv_lock_timeout_override \
      tests/unit/models/policy/test_policy_validation.py::test_te_graph_train_sharding_propagates_packed_sequence_capacity \
      tests/unit/models/policy/test_policy_validation.py::test_te_graph_logprob_sharding_propagates_packed_sequence_capacity \
      tests/unit/models/policy/test_policy_validation.py::test_shutdown_succeeds_before_worker_group_is_initialized
    MCORE_ROOT=3rdparty/Megatron-Bridge-workspace/Megatron-Bridge/3rdparty/Megatron-LM
    /opt/nemo_rl_venv/bin/python experiments/cuda_graph/mamba_moe_te_graph_20260729/run_pytest_with_te_overlay.py --expected-version ${TE_EXPECTED_VERSION} --expected-sha256 ${TE_FP64_WEAKREF_SHA256} -- \
      -q \
      \"\${MCORE_ROOT}/tests/unit_tests/transformer/test_packed_seq_params_cuda_graph.py\" \
      \"\${MCORE_ROOT}/tests/unit_tests/transformer/test_te_cuda_graph_bank.py\" \
      \"\${MCORE_ROOT}/tests/unit_tests/transformer/test_cuda_graphs.py::test_moe_router_fp64_output_is_preserved_at_te_graph_boundary\" \
      \"\${MCORE_ROOT}/tests/unit_tests/transformer/test_cuda_graphs.py::test_packed_mamba_te_cuda_graph_parity\" \
      \"\${MCORE_ROOT}/tests/unit_tests/transformer/test_cuda_graphs.py::test_te_graph_bank_schedule_switch_5_3_5\"
  "
