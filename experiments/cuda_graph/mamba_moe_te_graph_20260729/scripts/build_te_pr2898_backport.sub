#!/usr/bin/env bash
#SBATCH --nodes=1
#SBATCH --account=coreai_dlalgo_llm
#SBATCH --job-name=coreai_dlalgo_llm-sna-cg-study.te-pr2898-build
#SBATCH --partition=backfill
#SBATCH --time=01:00:00
#SBATCH --segment=1
#SBATCH --output=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg/logs/te-pr2898-build-%j.out

set -euo pipefail

fail() {
  echo "$*" >&2
  exit 2
}

ROOT=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg
TE_SOURCE=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg/src/TransformerEngine-fp64-thd-cudagraph-20260730
EXPECTED_TE_COMMIT=c16cb9a1d850f8b8228959145c98541958903b8f
IMAGE=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg/containers/nemo_rl_nightly_20260729_2472184.sqsh
IMAGE_SHA256=cb8ae0ade02b876f1b3380c8375eb92f95033dece6b2bfdc678b47f2da1aea91
TE_BUILD_JOBS=${TE_BUILD_JOBS:-8}
OUTPUT_ROOT=${ROOT}/artifacts/transformer-engine
OUTPUT_DIR=${OUTPUT_ROOT}/transformer-engine-pr2898-${EXPECTED_TE_COMMIT}
LOCK_DIR=${OUTPUT_DIR}.lock
BUILD_STAGING=
PUBLISH_STAGING=
LOCK_HELD=false
PUBLISHED=false

cleanup() {
  exit_code=$?
  trap - EXIT
  if [[ -n "${BUILD_STAGING}" && -d "${BUILD_STAGING}" ]]; then
    case "${BUILD_STAGING}" in
      "${OUTPUT_ROOT}"/.transformer-engine-pr2898-build-"${EXPECTED_TE_COMMIT}".*)
        rm -rf -- "${BUILD_STAGING}" || exit_code=2
        ;;
      *)
        echo "Refusing to clean unexpected build staging path: ${BUILD_STAGING}" >&2
        exit_code=2
        ;;
    esac
  fi
  if [[ "${PUBLISHED}" != true && -n "${PUBLISH_STAGING}" && -d "${PUBLISH_STAGING}" ]]; then
    case "${PUBLISH_STAGING}" in
      "${OUTPUT_ROOT}"/.transformer-engine-pr2898-publish-"${EXPECTED_TE_COMMIT}".*)
        rm -rf -- "${PUBLISH_STAGING}" || exit_code=2
        ;;
      *)
        echo "Refusing to clean unexpected publish staging path: ${PUBLISH_STAGING}" >&2
        exit_code=2
        ;;
    esac
  fi
  if [[ "${LOCK_HELD}" == true ]]; then
    rmdir -- "${LOCK_DIR}" || exit_code=2
  fi
  exit "${exit_code}"
}

trap cleanup EXIT

[[ "${TE_BUILD_JOBS}" =~ ^[1-9][0-9]*$ && "${TE_BUILD_JOBS}" -le 16 ]] || \
  fail "TE_BUILD_JOBS must be an integer from 1 through 16"
test -f "${IMAGE}"
test "$(sha256sum -- "${IMAGE}" | awk '{print $1}')" = "${IMAGE_SHA256}"
test -d "${TE_SOURCE}/.git"
test "$(git -C "${TE_SOURCE}" rev-parse HEAD)" = "${EXPECTED_TE_COMMIT}"
git -C "${TE_SOURCE}" diff --quiet
git -C "${TE_SOURCE}" diff --cached --quiet
if [[ -n "$(git -C "${TE_SOURCE}" status --porcelain --untracked-files=all)" ]]; then
  fail "Transformer Engine source must be clean"
fi
if git -C "${TE_SOURCE}" submodule status --recursive | grep -Eq '^[+-U]'; then
  fail "Transformer Engine source has missing or modified submodules"
fi

mkdir -p "${OUTPUT_ROOT}"
if ! mkdir "${LOCK_DIR}"; then
  fail "Another build owns the immutable output lock: ${LOCK_DIR}"
fi
LOCK_HELD=true
[[ ! -e "${OUTPUT_DIR}" ]] || fail "Refusing to replace immutable wheel output: ${OUTPUT_DIR}"
BUILD_STAGING=$(mktemp -d "${OUTPUT_ROOT}/.transformer-engine-pr2898-build-${EXPECTED_TE_COMMIT}.XXXXXX")
PUBLISH_STAGING=$(mktemp -d "${OUTPUT_ROOT}/.transformer-engine-pr2898-publish-${EXPECTED_TE_COMMIT}.XXXXXX")
BUILD_WHEEL_DIR=${BUILD_STAGING}/wheel
PUBLISH_WHEEL_DIR=${PUBLISH_STAGING}/wheel
mkdir -p "${BUILD_WHEEL_DIR}" "${PUBLISH_WHEEL_DIR}"

srun --nodes=1 --ntasks=1 \
  --container-image="${IMAGE}" \
  --container-mounts=/lustre:/lustre \
  bash -lc "
    set -euo pipefail
    cd ${TE_SOURCE}
    test \"\$(git rev-parse HEAD)\" = ${EXPECTED_TE_COMMIT}
    git diff --quiet
    git diff --cached --quiet
    export NVTE_FRAMEWORK=pytorch
    export NVTE_CUDA_ARCHS=100
    export MAX_JOBS=${TE_BUILD_JOBS}
    export PIP_NO_INDEX=1
    export PIP_NO_BUILD_ISOLATION=1
    export NVTE_CMAKE_BUILD_DIR=${BUILD_STAGING}/cmake
    /opt/nemo_rl_venv/bin/python setup.py \
      build --build-base \"${BUILD_STAGING}/setuptools-build\" \
      bdist_wheel --bdist-dir \"${BUILD_STAGING}/bdist\" --dist-dir \"${BUILD_WHEEL_DIR}\"
  "

wheels=()
while IFS= read -r wheel_path; do
  wheels+=("${wheel_path}")
done < <(find "${BUILD_WHEEL_DIR}" -maxdepth 1 -type f -name '*.whl' -print)
[[ "${#wheels[@]}" -eq 1 ]] || fail "Expected exactly one wheel, found ${#wheels[@]}"
wheel=${wheels[0]}
wheel_name=$(basename "${wheel}")
published_wheel=${PUBLISH_WHEEL_DIR}/${wheel_name}
mv -- "${wheel}" "${published_wheel}"
wheel_sha256=$(sha256sum -- "${published_wheel}" | awk '{print $1}')
printf '%s  %s\n' "${wheel_sha256}" "${wheel_name}" > "${published_wheel}.sha256"
printf '{\n  "source": "%s",\n  "commit": "%s",\n  "image": "%s",\n  "image_sha256": "%s",\n  "wheel": "%s",\n  "wheel_sha256": "%s",\n  "nvte_framework": "pytorch",\n  "nvte_cuda_archs": "100",\n  "max_jobs": %s\n}\n' \
  "${TE_SOURCE}" "${EXPECTED_TE_COMMIT}" "${IMAGE}" "${IMAGE_SHA256}" "${wheel_name}" \
  "${wheel_sha256}" "${TE_BUILD_JOBS}" > "${PUBLISH_STAGING}/provenance.json"
case "${BUILD_STAGING}" in
  "${OUTPUT_ROOT}"/.transformer-engine-pr2898-build-"${EXPECTED_TE_COMMIT}".*)
    rm -rf -- "${BUILD_STAGING}"
    ;;
  *)
    fail "Refusing to clean unexpected build staging path: ${BUILD_STAGING}"
    ;;
esac
BUILD_STAGING=
mv -T -- "${PUBLISH_STAGING}" "${OUTPUT_DIR}"
PUBLISHED=true
PUBLISH_STAGING=
rmdir -- "${LOCK_DIR}"
LOCK_HELD=false
trap - EXIT
printf 'TE_WHEEL_OUTPUT: %s\n' "${OUTPUT_DIR}"
