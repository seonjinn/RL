# GB200 OCI-HSG. Replace every __REQUIRED_*__ value with an immutable staged
# artifact before a real submission; keep the digest beside the sqsh path.
PROFILE_ID=oci-hsg-gb200
ACCOUNT=__REQUIRED_OCI_HSG_ACCOUNT__
PARTITION=batch
CONTAINER=__REQUIRED_OCI_HSG_IMMUTABLE_SQSH_PATH__
CONTAINER_SHA256=__REQUIRED_OCI_HSG_SQSH_SHA256__
HF_HOME=__REQUIRED_OCI_HSG_HF_HOME__
HF_DATASETS_CACHE=__REQUIRED_OCI_HSG_HF_DATASETS_CACHE__
MOUNTS=__REQUIRED_OCI_HSG_MOUNTS__
NVTE_CUDA_ARCHS=100
UV_CACHE_DIR_OVERRIDE=__REQUIRED_OCI_HSG_UV_CACHE_DIR__
SETUP_COMMAND="uv run --frozen --extra mcore python -c pass && uv pip install --python /opt/nemo_rl_venv/bin/python --reinstall --no-deps --no-cache urllib3==2.7.0 click==8.4.2 && ray --version"
RAY_CLIENT_SERVER_ENABLED=0

NANOV3_MODEL_SNAPSHOT=__REQUIRED_OCI_HSG_NANOV3_MODEL_SNAPSHOT__
NANOV3_TOKENIZER_SNAPSHOT=__REQUIRED_OCI_HSG_NANOV3_TOKENIZER_SNAPSHOT__
NANOV3_PRETRAINED_CHECKPOINT=__REQUIRED_OCI_HSG_NANOV3_PRETRAINED_CHECKPOINT__
QWEN3_30BA3B_SNAPSHOT=__REQUIRED_OCI_HSG_QWEN3_30BA3B_SNAPSHOT__
QWEN3_30BA3B_PRETRAINED_CHECKPOINT=__REQUIRED_OCI_HSG_QWEN3_30BA3B_PRETRAINED_CHECKPOINT__
QWEN3_235BA22B_SNAPSHOT=__REQUIRED_OCI_HSG_QWEN3_235BA22B_SNAPSHOT__
QWEN3_235BA22B_PRETRAINED_CHECKPOINT=__REQUIRED_OCI_HSG_QWEN3_235BA22B_PRETRAINED_CHECKPOINT__

NANOV3_TOTAL_NODES=8
NANOV3_INFERENCE_NODES=4
QWEN3_30BA3B_TOTAL_NODES=8
QWEN3_30BA3B_INFERENCE_NODES=4
QWEN3_235BA22B_TOTAL_NODES=__REQUIRED_OCI_HSG_QWEN3_235BA22B_TOTAL_NODES__
QWEN3_235BA22B_INFERENCE_NODES=__REQUIRED_OCI_HSG_QWEN3_235BA22B_INFERENCE_NODES__
GPUS_PER_NODE=4
SEGMENT_SIZE=4
TIME_LIMIT=04:00:00
SBATCH_GPU_ARGS=(--gres=gpu:4)
