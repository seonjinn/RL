#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:4
#SBATCH --mem=0
#SBATCH --partition=batch
#SBATCH --time=01:00:00
#SBATCH --job-name=validate_oci_container_runtime

set -euo pipefail

: "${CONTAINER:?Set CONTAINER to the immutable Enroot image path}"
: "${CONTAINER_SHA256:?Set CONTAINER_SHA256 to the immutable image SHA256}"
: "${ARTIFACT_DIR:?Set ARTIFACT_DIR to an absolute shared-storage path}"

ACCOUNT=${ACCOUNT:-coreai_dlalgo_nemorl}
PARTITION=${PARTITION:-batch}
TEST_ONLY=${TEST_ONLY:-0}
SBATCH_TEST_ONLY=${SBATCH_TEST_ONLY:-0}

if [[ "${CONTAINER}" != /* ]]; then
  echo "CONTAINER must be an absolute path" >&2
  exit 2
fi
if [[ ! "${CONTAINER_SHA256}" =~ ^[0-9a-f]{64}$ ]]; then
  echo "CONTAINER_SHA256 must be 64 lowercase hexadecimal characters" >&2
  exit 2
fi
if [[ "${ARTIFACT_DIR}" != /* ]]; then
  echo "ARTIFACT_DIR must be an absolute path" >&2
  exit 2
fi
if [[ "${PARTITION}" != "batch" ]]; then
  echo "OCI runtime validation requires PARTITION=batch" >&2
  exit 2
fi
if [[ ! "${TEST_ONLY}" =~ ^[01]$ || ! "${SBATCH_TEST_ONLY}" =~ ^[01]$ ]]; then
  echo "TEST_ONLY and SBATCH_TEST_ONLY must be 0 or 1" >&2
  exit 2
fi
if [[ "${TEST_ONLY}" == "1" && "${SBATCH_TEST_ONLY}" == "1" ]]; then
  echo "TEST_ONLY and SBATCH_TEST_ONLY are mutually exclusive" >&2
  exit 2
fi

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
script_path=${script_dir}/$(basename "${BASH_SOURCE[0]}")

if [[ -z "${SLURM_JOB_ID:-}" ]]; then
  CONTAINER_RUNTIME_VALIDATOR=${CONTAINER_RUNTIME_VALIDATOR:-$(cd "${script_dir}/.." && pwd -P)/validate_container_runtime.py}
  PROJECT_ROOT=${PROJECT_ROOT:-$(cd "${script_dir}/../../../.." && pwd -P)}
  SOURCE_PROVENANCE_VERIFIER=${SOURCE_PROVENANCE_VERIFIER:-${PROJECT_ROOT}/experiments/cuda_graph/nemotron_thd_te_graph_20260731/scripts/verify_source_provenance.sh}
  if [[ "${TEST_ONLY}" != "1" ]]; then
    : "${EXPECTED_NEMORL_SHA:?Set EXPECTED_NEMORL_SHA to the exact NeMo-RL commit}"
    : "${EXPECTED_BRIDGE_SHA:?Set EXPECTED_BRIDGE_SHA to the exact Megatron-Bridge commit}"
    : "${EXPECTED_MCORE_SHA:?Set EXPECTED_MCORE_SHA to the exact Megatron-LM commit}"
    : "${EXPECTED_TE_SHA:?Set EXPECTED_TE_SHA to the exact Transformer Engine commit}"
  fi
  if [[ "${CONTAINER_RUNTIME_VALIDATOR}" != /* || ! -f "${CONTAINER_RUNTIME_VALIDATOR}" ]]; then
    echo "CONTAINER_RUNTIME_VALIDATOR must be an existing absolute path" >&2
    exit 2
  fi
  if [[ "${PROJECT_ROOT}" != /* || ! -f "${PROJECT_ROOT}/pyproject.toml" || ! -f "${PROJECT_ROOT}/uv.lock" || ! -f "${PROJECT_ROOT}/.python-version" || ! -f "${PROJECT_ROOT}/docker/Dockerfile" ]]; then
    echo "PROJECT_ROOT must be an absolute NeMo-RL checkout with pyproject.toml, uv.lock, .python-version, and docker/Dockerfile" >&2
    exit 2
  fi
  if [[ "${SOURCE_PROVENANCE_VERIFIER}" != /* || ! -x "${SOURCE_PROVENANCE_VERIFIER}" ]]; then
    echo "SOURCE_PROVENANCE_VERIFIER must be an existing absolute executable" >&2
    exit 2
  fi
  if [[ "${TEST_ONLY}" != "1" ]]; then
    for commit in "${EXPECTED_NEMORL_SHA}" "${EXPECTED_BRIDGE_SHA}" "${EXPECTED_MCORE_SHA}" "${EXPECTED_TE_SHA}"; do
      if [[ ! "${commit}" =~ ^[0-9a-f]{40}$ ]]; then
        echo "Expected source commits must be full lowercase hexadecimal SHAs" >&2
        exit 2
      fi
    done
  fi
  export ACCOUNT ARTIFACT_DIR CONTAINER CONTAINER_RUNTIME_VALIDATOR
  export CONTAINER_SHA256 PARTITION PROJECT_ROOT SOURCE_PROVENANCE_VERIFIER
  export EXPECTED_NEMORL_SHA EXPECTED_BRIDGE_SHA EXPECTED_MCORE_SHA EXPECTED_TE_SHA
  export_spec=CONTAINER,CONTAINER_SHA256,ARTIFACT_DIR,CONTAINER_RUNTIME_VALIDATOR,PROJECT_ROOT,SOURCE_PROVENANCE_VERIFIER,EXPECTED_NEMORL_SHA,EXPECTED_BRIDGE_SHA,EXPECTED_MCORE_SHA,EXPECTED_TE_SHA,ACCOUNT,PARTITION,HOME,USER,LOGNAME,SHELL,PATH,LD_LIBRARY_PATH,HTTP_PROXY,HTTPS_PROXY,NO_PROXY,http_proxy,https_proxy,no_proxy
  submission_flag=--parsable
  if [[ "${SBATCH_TEST_ONLY}" == "1" ]]; then
    submission_flag=--test-only
  fi
  sbatch_command=(
    sbatch
    "${submission_flag}"
    "--partition=${PARTITION}"
    "--account=${ACCOUNT}"
    --gres=gpu:4
    "--output=${ARTIFACT_DIR}/oci-container-runtime-%j.log"
    "--export=${export_spec}"
    "${script_path}"
  )
  printf 'SBATCH:'
  printf ' %q' "${sbatch_command[@]}"
  printf '\n'
  if [[ "${TEST_ONLY}" == "1" ]]; then
    echo "TEST_ONLY: no submission performed (local render only; scheduler not contacted)"
    exit 0
  fi
  if [[ "${SBATCH_TEST_ONLY}" != "1" ]]; then
    mkdir -p "${ARTIFACT_DIR}"
  fi
  "${sbatch_command[@]}"
  exit 0
fi

: "${CONTAINER_RUNTIME_VALIDATOR:?Submission must export CONTAINER_RUNTIME_VALIDATOR}"
if [[ "${CONTAINER_RUNTIME_VALIDATOR}" != /* || ! -f "${CONTAINER_RUNTIME_VALIDATOR}" ]]; then
  echo "CONTAINER_RUNTIME_VALIDATOR must be an existing absolute path" >&2
  exit 1
fi
if [[ -z "${PROJECT_ROOT:-}" ]]; then
  PROJECT_ROOT=$(cd "$(dirname "${CONTAINER_RUNTIME_VALIDATOR}")/../../.." && pwd -P)
fi
if [[ "${PROJECT_ROOT}" != /* || ! -f "${PROJECT_ROOT}/pyproject.toml" || ! -f "${PROJECT_ROOT}/uv.lock" || ! -f "${PROJECT_ROOT}/.python-version" || ! -f "${PROJECT_ROOT}/docker/Dockerfile" ]]; then
  echo "PROJECT_ROOT must be an absolute NeMo-RL checkout with pyproject.toml, uv.lock, .python-version, and docker/Dockerfile" >&2
  exit 1
fi
validator=${CONTAINER_RUNTIME_VALIDATOR}
validator=$(cd "$(dirname "${validator}")" && pwd -P)/$(basename "${validator}")
project_root=$(cd "${PROJECT_ROOT}" && pwd -P)
if [[ "${validator}" != "${project_root}/"* ]]; then
  echo "CONTAINER_RUNTIME_VALIDATOR must be inside PROJECT_ROOT" >&2
  exit 1
fi

unset PYTHONHOME PYTHONPATH VIRTUAL_ENV UV_PROJECT_ENVIRONMENT

if [[ -L "${CONTAINER}" ]]; then
  echo "Immutable container path must not be a symlink: ${CONTAINER}" >&2
  exit 1
fi
[[ -f "${CONTAINER}" ]] || {
  echo "Immutable container is missing: ${CONTAINER}" >&2
  exit 1
}
: "${EXPECTED_NEMORL_SHA:?Submission must export EXPECTED_NEMORL_SHA}"
: "${EXPECTED_BRIDGE_SHA:?Submission must export EXPECTED_BRIDGE_SHA}"
: "${EXPECTED_MCORE_SHA:?Submission must export EXPECTED_MCORE_SHA}"
: "${EXPECTED_TE_SHA:?Submission must export EXPECTED_TE_SHA}"
: "${SOURCE_PROVENANCE_VERIFIER:?Submission must export SOURCE_PROVENANCE_VERIFIER}"
for commit in "${EXPECTED_NEMORL_SHA}" "${EXPECTED_BRIDGE_SHA}" "${EXPECTED_MCORE_SHA}" "${EXPECTED_TE_SHA}"; do
  if [[ ! "${commit}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "Expected source commits must be full lowercase hexadecimal SHAs" >&2
    exit 1
  fi
done
if [[ "${SOURCE_PROVENANCE_VERIFIER}" != /* || ! -x "${SOURCE_PROVENANCE_VERIFIER}" ]]; then
  echo "SOURCE_PROVENANCE_VERIFIER must be an existing absolute executable" >&2
  exit 1
fi
bridge_root=${project_root}/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge
mcore_root=${bridge_root}/3rdparty/Megatron-LM
"${SOURCE_PROVENANCE_VERIFIER}" \
  "${project_root}" "${EXPECTED_NEMORL_SHA}" \
  "${bridge_root}" "${EXPECTED_BRIDGE_SHA}" \
  "${mcore_root}" "${EXPECTED_MCORE_SHA}"
uv_lock_sha256=$(sha256sum "${project_root}/uv.lock" | awk '{print $1}')
actual_container_sha256=$(sha256sum "${CONTAINER}" | awk '{print $1}')
if [[ "${actual_container_sha256}" != "${CONTAINER_SHA256}" ]]; then
  echo "Immutable container SHA256 mismatch" >&2
  exit 1
fi
if stat --version >/dev/null 2>&1; then
  read -r container_device container_inode container_size \
    container_mtime_seconds container_ctime_seconds < <(
      stat -Lc '%d %i %s %Y %Z' -- "${CONTAINER}"
    )
else
  read -r container_device container_inode container_size \
    container_mtime_seconds container_ctime_seconds < <(
      stat -f '%d %i %z %m %c' "${CONTAINER}"
    )
fi
[[ -f "${validator}" ]] || {
  echo "Runtime probe is missing: ${validator}" >&2
  exit 1
}

mkdir -p "${ARTIFACT_DIR}"
expected_python_version=$(tr -d '[:space:]' <"${project_root}/.python-version")
if [[ ! "${expected_python_version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo ".python-version must contain one exact X.Y.Z version" >&2
  exit 1
fi
python_install_dir=${ARTIFACT_DIR%/}/uv-python-installations
mkdir -p "${python_install_dir}"
expected_uv_version=$(sed -nE 's/^ARG UV_VERSION=([0-9]+\.[0-9]+\.[0-9]+)$/\1/p' "${project_root}/docker/Dockerfile")
if [[ ! "${expected_uv_version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "docker/Dockerfile must contain one exact ARG UV_VERSION=X.Y.Z pin" >&2
  exit 1
fi
uv_bin_dir=${ARTIFACT_DIR%/}/uv-${expected_uv_version}-${SLURM_JOB_ID}
uv_executable=${uv_bin_dir}/uv
artifact=${ARTIFACT_DIR}/oci-container-runtime-${SLURM_JOB_ID}.json
partial_artifact=${artifact}.partial
diagnostic=${ARTIFACT_DIR}/oci-container-runtime-${SLURM_JOB_ID}.diagnostics.log
current_link=${ARTIFACT_DIR}/oci-container-runtime-latest.json
partial_link=${current_link}.partial.${SLURM_JOB_ID}
if [[ -e "${artifact}" || -e "${diagnostic}" ]]; then
  echo "Immutable runtime artifact or diagnostic already exists for job ${SLURM_JOB_ID}" >&2
  exit 1
fi
rm -f "${partial_artifact}" "${partial_link}"

container_mounts="${project_root}:${project_root}:ro,${ARTIFACT_DIR}:${ARTIFACT_DIR}"
runtime_environment_root=/tmp/nemo-rl-runtime-${SLURM_JOB_ID}
runtime_site_packages=${runtime_environment_root}/lib/python3.13/site-packages
runtime_environment=(
  /usr/bin/env
  -i
  HOME=/root
  PATH=/root/.local/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin:/opt/nemo_rl_venv/bin
  CUDA_HOME=/usr/local/cuda
  CUDACXX=/usr/local/cuda/bin/nvcc
  CPLUS_INCLUDE_PATH=/usr/local/cuda/include/cccl
  "CUDNN_HOME=${runtime_site_packages}/nvidia/cudnn"
  "CUDNN_PATH=${runtime_site_packages}/nvidia/cudnn"
  "LD_LIBRARY_PATH=${runtime_site_packages}/nvidia/cudnn/lib:/usr/local/cuda/lib64:/usr/local/cuda/compat:/usr/local/lib:/usr/lib/x86_64-linux-gnu:/usr/lib/aarch64-linux-gnu"
  NRL_CONTAINER=1
  NRL_FORCE_REBUILD_VENVS=true
  NVTE_WITH_NCCL_EP=0
  "PINNED_UV_VERSION=${expected_uv_version}"
  "UV_EXECUTABLE=${uv_executable}"
  UV_LINK_MODE=copy
  "UV_PYTHON=${expected_python_version}"
  UV_MANAGED_PYTHON=1
  "UV_PYTHON_INSTALL_DIR=${python_install_dir}"
  "UV_PROJECT_ENVIRONMENT=${runtime_environment_root}"
)
for proxy_variable in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do
  if [[ -n "${!proxy_variable:-}" ]]; then
    runtime_environment+=("${proxy_variable}=${!proxy_variable}")
  fi
done
runtime_command='set -euo pipefail
source_project_root=$1
source_validator=$2
environment_root=$3
container=$4
container_sha256=$5
nemo_rl_commit=$6
bridge_commit=$7
mcore_commit=$8
uv_lock_sha256=$9
expected_te_commit=${10}
container_device=${11}
container_inode=${12}
container_size=${13}
container_mtime_seconds=${14}
container_ctime_seconds=${15}
output_flag=${16}
output=${17}
if [[ "${output_flag}" != "--output" ]]; then
  echo "Runtime probe payload requires --output" >&2
  exit 2
fi
if [[ "${source_validator}" != "${source_project_root}/"* ]]; then
  echo "Runtime probe validator must be inside the immutable source root" >&2
  exit 2
fi
cuda_home=${CUDA_HOME:-}
cuda_compiler=${CUDACXX:-}
if [[ -z "${cuda_home}" || "${cuda_home}" != /* ]]; then
  echo "Runtime probe requires an absolute CUDA_HOME" >&2
  exit 2
fi
if [[ "${cuda_compiler}" != "${cuda_home%/}/bin/nvcc" ]]; then
  echo "CUDACXX must name CUDA_HOME/bin/nvcc" >&2
  exit 2
fi
if [[ ! -x "${cuda_compiler}" ]]; then
  echo "CUDA compiler is missing or not executable: ${cuda_compiler}" >&2
  exit 2
fi
path_cuda_compiler=$(command -v nvcc || true)
if [[ "${path_cuda_compiler}" != "${cuda_compiler}" ]]; then
  echo "PATH nvcc does not match CUDACXX: ${path_cuda_compiler:-missing}" >&2
  exit 2
fi
validator_relative_path=${source_validator#"${source_project_root}/"}
runtime_project_root=${environment_root}-source
if [[ -e "${runtime_project_root}" || -L "${runtime_project_root}" ]]; then
  echo "Runtime source destination already exists: ${runtime_project_root}" >&2
  exit 2
fi
mkdir -m 0700 -- "${runtime_project_root}"
cleanup_runtime_workspace() {
  rm -rf -- "${environment_root}" "${runtime_project_root}"
}
trap cleanup_runtime_workspace EXIT
cp -a -- "${source_project_root}/." "${runtime_project_root}/"
project_root=${runtime_project_root}
validator=${project_root}/${validator_relative_path}
source_provenance_verifier=${project_root}/experiments/cuda_graph/nemotron_thd_te_graph_20260731/scripts/verify_source_provenance.sh
bridge_root=${project_root}/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge
mcore_root=${bridge_root}/3rdparty/Megatron-LM
if [[ ! -f "${validator}" || ! -x "${source_provenance_verifier}" ]]; then
  echo "Runtime source copy is missing its validator or provenance verifier" >&2
  exit 2
fi
verify_no_ignored_source_paths() {
  local repository=$1
  local label=$2
  local allow_source_manifest=$3
  local index=$4
  local ignored_path
  local ignored_paths_file=${project_root}/.git/runtime-ignored-paths-${index}
  git -C "${repository}" ls-files -z --others --ignored --exclude-standard >"${ignored_paths_file}"
  while IFS= read -r -d "" ignored_path; do
    if [[ "${allow_source_manifest}" == "1" && "${ignored_path}" == ".source-manifest.env" ]]; then
      if [[ -L "${repository}/${ignored_path}" || ! -f "${repository}/${ignored_path}" ]]; then
        echo "Runtime source manifest must be a regular non-symlink file" >&2
        return 2
      fi
      continue
    fi
    echo "Runtime source copy contains unexpected ignored path: ${label}:${ignored_path}" >&2
    return 2
  done <"${ignored_paths_file}"
  rm -f -- "${ignored_paths_file}"
}
verify_no_ignored_source_paths "${project_root}" "NeMo-RL" 1 0
verify_no_ignored_source_paths "${bridge_root}" "Megatron-Bridge" 0 1
verify_no_ignored_source_paths "${mcore_root}" "Megatron-LM" 0 2
"${source_provenance_verifier}" \
  "${project_root}" "${nemo_rl_commit}" \
  "${bridge_root}" "${bridge_commit}" \
  "${mcore_root}" "${mcore_commit}"
copied_uv_lock_sha256=$(sha256sum "${project_root}/uv.lock" | awk "{print \$1}")
if [[ "${copied_uv_lock_sha256}" != "${uv_lock_sha256}" ]]; then
  echo "Runtime source copy uv.lock SHA256 mismatch" >&2
  exit 2
fi
expected_uv_version=$(sed -nE "s/^ARG UV_VERSION=([0-9]+\\.[0-9]+\\.[0-9]+)$/\\1/p" "${project_root}/docker/Dockerfile")
if [[ "${PINNED_UV_VERSION:?Runtime probe requires the source-pinned uv version}" != "${expected_uv_version}" ]]; then
  echo "PINNED_UV_VERSION does not match docker/Dockerfile" >&2
  exit 2
fi
uv_executable=${UV_EXECUTABLE:?Runtime probe requires an exact uv executable}
uv_bin_dir=$(dirname "${uv_executable}")
if [[ "${uv_executable}" != "${uv_bin_dir}/uv" || "${uv_bin_dir}" != /* ]]; then
  echo "UV_EXECUTABLE must be an absolute uv binary path" >&2
  exit 2
fi
if [[ -L "${uv_bin_dir}" || -L "${uv_executable}" ]]; then
  echo "Pinned uv path must not be a symlink" >&2
  exit 2
fi
if [[ -e "${uv_bin_dir}" || -L "${uv_bin_dir}" ]]; then
  echo "Pinned uv destination already exists: ${uv_bin_dir}" >&2
  exit 2
fi
command -v curl >/dev/null || {
  echo "curl is required to stage pinned uv" >&2
  exit 2
}
command -v sha256sum >/dev/null || {
  echo "sha256sum is required for installer artifact verification" >&2
  exit 2
}
staging_uv_dir=${uv_bin_dir}.partial
uv_installer=${uv_bin_dir}.installer.sh
rm -rf -- "${staging_uv_dir}" "${uv_installer}"
cleanup_uv_stage() {
  rm -rf -- "${staging_uv_dir}" "${uv_installer}"
}
cleanup_uv_stage_and_workspace() {
  cleanup_uv_stage
  cleanup_runtime_workspace
}
trap cleanup_uv_stage_and_workspace EXIT
curl --retry 3 --retry-delay 2 -fsSL \
  -o "${uv_installer}" \
  "https://astral.sh/uv/${expected_uv_version}/install.sh"
env UV_UNMANAGED_INSTALL="${staging_uv_dir}" sh "${uv_installer}"
staging_uv_executable=${staging_uv_dir}/uv
[[ -x "${staging_uv_executable}" ]] || {
  echo "Pinned uv installer did not create ${staging_uv_executable}" >&2
  exit 2
}
staging_uv_version=$("${staging_uv_executable}" --version | awk "{print \$2}")
if [[ "${staging_uv_version}" != "${expected_uv_version}" ]]; then
  echo "Staged uv version mismatch: expected ${expected_uv_version}, got ${staging_uv_version}" >&2
  exit 2
fi
mv --no-clobber --no-target-directory -- "${staging_uv_dir}" "${uv_bin_dir}"
[[ ! -e "${staging_uv_dir}" && ! -L "${staging_uv_dir}" ]] || {
  echo "Pinned uv destination appeared during publication: ${uv_bin_dir}" >&2
  exit 2
}
rm -f -- "${uv_installer}"
trap cleanup_runtime_workspace EXIT
actual_uv_version=$("${uv_executable}" --version | awk "{print \$2}")
if [[ "${actual_uv_version}" != "${expected_uv_version}" ]]; then
  echo "Pinned uv version mismatch: expected ${expected_uv_version}, got ${actual_uv_version}" >&2
  exit 2
fi
expected_python_version=$(tr -d "[:space:]" <"${project_root}/.python-version")
if [[ "${UV_PYTHON:?Runtime probe requires an exact Python version}" != "${expected_python_version}" ]]; then
  echo "UV_PYTHON does not match .python-version" >&2
  exit 2
fi
python_install_dir=${UV_PYTHON_INSTALL_DIR:?Runtime probe requires a managed Python install directory}
"${uv_executable}" python install --managed-python --no-bin "${expected_python_version}"
export UV_PYTHON_DOWNLOADS=never
base_python=$("${uv_executable}" python find --managed-python "${expected_python_version}")
if [[ ! -x "${base_python}" ]]; then
  echo "Managed Python is missing or not executable: ${base_python}" >&2
  exit 2
fi
actual_python_version=$("${base_python}" -c "import platform; print(platform.python_version())")
if [[ "${actual_python_version}" != "${expected_python_version}" ]]; then
  echo "Managed Python version mismatch: expected ${expected_python_version}, got ${actual_python_version}" >&2
  exit 2
fi
rm -rf -- "${environment_root}"
cd "${project_root}"
"${uv_executable}" run --python "${expected_python_version}" --managed-python --locked --extra mcore --no-python-downloads --directory "${project_root}" python "${validator}" \
  --container-image "${container}" \
  --container-sha256 "${container_sha256}" \
  --expected-device-count 4 \
  --expected-environment-root "${environment_root}" \
  --expected-project-root "${project_root}" \
  --expected-python-version "${expected_python_version}" \
  --expected-python-install-dir "${python_install_dir}" \
  --expected-uv-version "${expected_uv_version}" \
  --expected-uv-executable "${uv_executable}" \
  --expected-nvte-with-nccl-ep "0" \
  --nemo-rl-commit "${nemo_rl_commit}" \
  --bridge-commit "${bridge_commit}" \
  --mcore-commit "${mcore_commit}" \
  --uv-lock-sha256 "${uv_lock_sha256}" \
  --expected-te-commit "${expected_te_commit}" \
  --container-device "${container_device}" \
  --container-inode "${container_inode}" \
  --container-size "${container_size}" \
  --container-mtime-seconds "${container_mtime_seconds}" \
  --container-ctime-seconds "${container_ctime_seconds}" \
  --output "${output}"'

set +e
srun \
  --nodes=1 \
  --ntasks=1 \
  --gres=gpu:4 \
  --container-image="${CONTAINER}" \
  --container-mounts="${container_mounts}" \
  --export=NIL \
  "${runtime_environment[@]}" \
  /bin/bash --noprofile --norc -c "${runtime_command}" bash \
    "${project_root}" \
    "${validator}" \
    "${runtime_environment_root}" \
    "${CONTAINER}" \
    "${actual_container_sha256}" \
    "${EXPECTED_NEMORL_SHA}" \
    "${EXPECTED_BRIDGE_SHA}" \
    "${EXPECTED_MCORE_SHA}" \
    "${uv_lock_sha256}" \
    "${EXPECTED_TE_SHA}" \
    "${container_device}" \
    "${container_inode}" \
    "${container_size}" \
    "${container_mtime_seconds}" \
    "${container_ctime_seconds}" \
    --output "${partial_artifact}" \
  2>&1 | tee "${diagnostic}"
probe_status=${PIPESTATUS[0]}
set -e

if [[ -f "${partial_artifact}" ]]; then
  mv "${partial_artifact}" "${artifact}"
  ln -s "$(basename "${artifact}")" "${partial_link}"
  mv -f "${partial_link}" "${current_link}"
fi
if [[ ${probe_status} -ne 0 ]]; then
  echo "OCI container runtime smoke failed; artifact=${artifact}; diagnostic=${diagnostic}" >&2
  exit "${probe_status}"
fi

echo "OCI_CONTAINER_RUNTIME_ARTIFACT=${artifact}"
echo "OCI_CONTAINER_RUNTIME_DIAGNOSTIC=${diagnostic}"
