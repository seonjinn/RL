#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --partition=batch
#SBATCH --time=04:00:00
#SBATCH --job-name=validate_oci_container_runtime

set -euo pipefail

: "${CONTAINER:?Set CONTAINER to the immutable Enroot image path}"
: "${CONTAINER_SHA256:?Set CONTAINER_SHA256 to the immutable image SHA256}"
: "${ARTIFACT_DIR:?Set ARTIFACT_DIR to an absolute shared-storage path}"

ACCOUNT=${ACCOUNT:-coreai_dlalgo_nemorl}
PARTITION=${PARTITION:-batch}
TEST_ONLY=${TEST_ONLY:-0}
SBATCH_TEST_ONLY=${SBATCH_TEST_ONLY:-0}
RUNTIME_PHASE=${RUNTIME_PHASE:-attest}
NVTE_CUDA_ARCHS=${NVTE_CUDA_ARCHS:-100a}
TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST:-10.0a}
RUNTIME_FEATURE_SET=${RUNTIME_FEATURE_SET:-te_eval_capability_8}
RUNTIME_EXCLUDED_PACKAGES=${RUNTIME_EXCLUDED_PACKAGES:-causal-conv1d,deep-ep,fast-hadamard-transform,mamba-ssm}
RUNTIME_STAGE_CAPABILITY=${RUNTIME_STAGE_CAPABILITY:-}
RUNTIME_TEST_REQUIREMENTS=${RUNTIME_TEST_REQUIREMENTS:-pytest==9.1.1,iniconfig==2.3.0,packaging==26.2,pluggy==1.6.0,pygments==2.20.0}
STAGE_PARTITION=${STAGE_PARTITION:-cpu}
RUNTIME_STAGE_CPUS_PER_TASK=${RUNTIME_STAGE_CPUS_PER_TASK:-32}
SBATCH_GPUS_PER_NODE=${SBATCH_GPUS_PER_NODE:-4}
SBATCH_GRES=${SBATCH_GRES:-gpu:4}

if [[ "${CONTAINER}" != /* ]]; then
  echo "CONTAINER must be an absolute path" >&2
  exit 2
fi
if [[ ! "${CONTAINER_SHA256}" =~ ^[0-9a-f]{64}$ ]]; then
  echo "CONTAINER_SHA256 must be 64 lowercase hexadecimal characters" >&2
  exit 2
fi
if [[ "${ARTIFACT_DIR}" != /* ]]; then
  echo "ARTIFACT_DIR must be an absolute path" >&2
  exit 2
fi
if [[ "${PARTITION}" != "batch" ]]; then
  echo "OCI runtime validation requires PARTITION=batch" >&2
  exit 2
fi
if [[ ! "${TEST_ONLY}" =~ ^[01]$ || ! "${SBATCH_TEST_ONLY}" =~ ^[01]$ ]]; then
  echo "TEST_ONLY and SBATCH_TEST_ONLY must be 0 or 1" >&2
  exit 2
fi
if [[ "${RUNTIME_PHASE}" != "stage" && "${RUNTIME_PHASE}" != "attest" ]]; then
  echo "RUNTIME_PHASE must be stage or attest" >&2
  exit 2
fi
if [[ "${NVTE_CUDA_ARCHS}" != "100a" ]]; then
  echo "OCI runtime staging requires NVTE_CUDA_ARCHS=100a" >&2
  exit 2
fi
if [[ "${TORCH_CUDA_ARCH_LIST}" != "10.0a" ]]; then
  echo "OCI runtime staging requires TORCH_CUDA_ARCH_LIST=10.0a" >&2
  exit 2
fi
case "${RUNTIME_FEATURE_SET}" in
  te_eval_capability_8|bridge_forward_only_eval_8)
    expected_runtime_exclusions=causal-conv1d,deep-ep,fast-hadamard-transform,mamba-ssm
    ;;
  dropless_hybridep_nano16|dropless_hybridep_qwen235_64)
    expected_runtime_exclusions=fast-hadamard-transform
    ;;
  dropless_alltoall_qwen30_16|dropless_alltoall_super32)
    expected_runtime_exclusions=deep-ep,fast-hadamard-transform
    ;;
  *)
    echo "RUNTIME_FEATURE_SET must select one typed runtime row" >&2
    exit 2
    ;;
esac
if [[ "${RUNTIME_EXCLUDED_PACKAGES}" != "${expected_runtime_exclusions}" ]]; then
  echo "RUNTIME_EXCLUDED_PACKAGES does not match ${RUNTIME_FEATURE_SET}" >&2
  exit 2
fi
if [[ "${RUNTIME_STAGE_CAPABILITY}" != "mcore-test-v1" ]]; then
  echo "RUNTIME_STAGE_CAPABILITY must explicitly select mcore-test-v1" >&2
  exit 2
fi
if [[ "${RUNTIME_TEST_REQUIREMENTS}" != "pytest==9.1.1,iniconfig==2.3.0,packaging==26.2,pluggy==1.6.0,pygments==2.20.0" ]]; then
  echo "RUNTIME_TEST_REQUIREMENTS must match the lock-pinned mcore-test-v1 identity" >&2
  exit 2
fi
case "${STAGE_PARTITION}" in
  cpu|cpu_datamover|batch) ;;
  *)
    echo "Runtime staging requires STAGE_PARTITION=cpu, cpu_datamover, or batch" >&2
    exit 2
    ;;
esac
if [[ "${SBATCH_GPUS_PER_NODE}" != "4" ]]; then
  echo "Runtime attestation requires SBATCH_GPUS_PER_NODE=4" >&2
  exit 2
fi
case "${SBATCH_GRES}" in
  none|gpu:4) ;;
  *)
    echo "SBATCH_GRES must be none or gpu:4" >&2
    exit 2
    ;;
esac
if [[ ! "${RUNTIME_STAGE_CPUS_PER_TASK}" =~ ^[0-9]+$ ]] ||
   ((RUNTIME_STAGE_CPUS_PER_TASK < 1 || RUNTIME_STAGE_CPUS_PER_TASK > 96)); then
  echo "RUNTIME_STAGE_CPUS_PER_TASK must be an integer from 1 through 96" >&2
  exit 2
fi
if [[ "${TEST_ONLY}" == "1" && "${SBATCH_TEST_ONLY}" == "1" ]]; then
  echo "TEST_ONLY and SBATCH_TEST_ONLY are mutually exclusive" >&2
  exit 2
fi

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
script_path=${script_dir}/$(basename "${BASH_SOURCE[0]}")

if [[ -z "${SLURM_JOB_ID:-}" ]]; then
  CONTAINER_RUNTIME_VALIDATOR=${CONTAINER_RUNTIME_VALIDATOR:-$(cd "${script_dir}/.." && pwd -P)/validate_container_runtime.py}
  PROJECT_ROOT=${PROJECT_ROOT:-$(cd "${script_dir}/../../../.." && pwd -P)}
  SOURCE_PROVENANCE_VERIFIER=${SOURCE_PROVENANCE_VERIFIER:-${PROJECT_ROOT}/experiments/cuda_graph/nemotron_thd_te_graph_20260731/scripts/verify_source_provenance.sh}
  if [[ "${TEST_ONLY}" != "1" ]]; then
    : "${EXPECTED_NEMORL_SHA:?Set EXPECTED_NEMORL_SHA to the exact NeMo-RL commit}"
    : "${EXPECTED_BRIDGE_SHA:?Set EXPECTED_BRIDGE_SHA to the exact Megatron-Bridge commit}"
    : "${EXPECTED_MCORE_SHA:?Set EXPECTED_MCORE_SHA to the exact Megatron-LM commit}"
    : "${EXPECTED_TE_SHA:?Set EXPECTED_TE_SHA to the exact Transformer Engine commit}"
    : "${EXPECTED_TE_VERSION_BASE_SHA:?Set EXPECTED_TE_VERSION_BASE_SHA to the exact Transformer Engine version-base commit}"
  fi
  uv_lock_sha256=$(sha256sum "${PROJECT_ROOT}/uv.lock" | awk '{print $1}')
  expected_python_version=$(tr -d '[:space:]' <"${PROJECT_ROOT}/.python-version")
  expected_uv_version=$(sed -nE 's/^ARG UV_VERSION=([0-9]+\.[0-9]+\.[0-9]+)$/\1/p' "${PROJECT_ROOT}/docker/Dockerfile")
  if [[ "${TEST_ONLY}" == "1" ]]; then
    EXPECTED_NEMORL_SHA=${EXPECTED_NEMORL_SHA:-0000000000000000000000000000000000000000}
    EXPECTED_BRIDGE_SHA=${EXPECTED_BRIDGE_SHA:-0000000000000000000000000000000000000000}
    EXPECTED_MCORE_SHA=${EXPECTED_MCORE_SHA:-0000000000000000000000000000000000000000}
    EXPECTED_TE_SHA=${EXPECTED_TE_SHA:-0000000000000000000000000000000000000000}
    EXPECTED_TE_VERSION_BASE_SHA=${EXPECTED_TE_VERSION_BASE_SHA:-0000000000000000000000000000000000000000}
  fi
  runtime_stage_key=$(printf '%s\n' \
    runtime-stage-v1 \
    "${CONTAINER_SHA256}" \
    "${uv_lock_sha256}" \
    "${EXPECTED_NEMORL_SHA}" \
    "${EXPECTED_BRIDGE_SHA}" \
    "${EXPECTED_MCORE_SHA}" \
    "${EXPECTED_TE_SHA}" \
    "${EXPECTED_TE_VERSION_BASE_SHA}" \
    "${expected_python_version}" \
    "${expected_uv_version}" \
    "${RUNTIME_FEATURE_SET}" \
    "${RUNTIME_EXCLUDED_PACKAGES}" \
    "${RUNTIME_STAGE_CAPABILITY}" \
    "${RUNTIME_TEST_REQUIREMENTS}" \
    "${TORCH_CUDA_ARCH_LIST}" \
    "${NVTE_CUDA_ARCHS}" \
    "${RUNTIME_STAGE_CPUS_PER_TASK}" | sha256sum | awk '{print $1}')
  RUNTIME_STAGE_ROOT=${ARTIFACT_DIR%/}/staged-runtimes/${runtime_stage_key}
  RUNTIME_STAGE_MARKER=${ARTIFACT_DIR%/}/stage-markers/${runtime_stage_key}.env
  stage_marker_content=$(printf '%s\n' \
    'schema=runtime-stage-v1' \
    "stage_key=${runtime_stage_key}" \
    "container_sha256=${CONTAINER_SHA256}" \
    "uv_lock_sha256=${uv_lock_sha256}" \
    "nemo_rl_commit=${EXPECTED_NEMORL_SHA}" \
    "bridge_commit=${EXPECTED_BRIDGE_SHA}" \
    "mcore_commit=${EXPECTED_MCORE_SHA}" \
    "te_source_commit=${EXPECTED_TE_SHA}" \
    "te_version_base_commit=${EXPECTED_TE_VERSION_BASE_SHA}" \
    "python_version=${expected_python_version}" \
    "uv_version=${expected_uv_version}" \
    "feature_set=${RUNTIME_FEATURE_SET}" \
    "excluded_packages=${RUNTIME_EXCLUDED_PACKAGES}" \
    "stage_capability=${RUNTIME_STAGE_CAPABILITY}" \
    "test_requirements=${RUNTIME_TEST_REQUIREMENTS}" \
    "torch_cuda_arch_list=${TORCH_CUDA_ARCH_LIST}" \
    "cuda_archs=${NVTE_CUDA_ARCHS}" \
    "stage_cpus_per_task=${RUNTIME_STAGE_CPUS_PER_TASK}")
  RUNTIME_STAGE_MARKER_SHA256=$(printf '%s\n' "${stage_marker_content}" | sha256sum | awk '{print $1}')
  RUNTIME_STAGE_JOB_ID=${RUNTIME_STAGE_JOB_ID:-}
  if [[ "${CONTAINER_RUNTIME_VALIDATOR}" != /* || ! -f "${CONTAINER_RUNTIME_VALIDATOR}" ]]; then
    echo "CONTAINER_RUNTIME_VALIDATOR must be an existing absolute path" >&2
    exit 2
  fi
  if [[ "${PROJECT_ROOT}" != /* || ! -f "${PROJECT_ROOT}/pyproject.toml" || ! -f "${PROJECT_ROOT}/uv.lock" || ! -f "${PROJECT_ROOT}/.python-version" || ! -f "${PROJECT_ROOT}/docker/Dockerfile" ]]; then
    echo "PROJECT_ROOT must be an absolute NeMo-RL checkout with pyproject.toml, uv.lock, .python-version, and docker/Dockerfile" >&2
    exit 2
  fi
  if [[ "${SOURCE_PROVENANCE_VERIFIER}" != /* || ! -x "${SOURCE_PROVENANCE_VERIFIER}" ]]; then
    echo "SOURCE_PROVENANCE_VERIFIER must be an existing absolute executable" >&2
    exit 2
  fi
  if [[ "${TEST_ONLY}" != "1" ]]; then
    for commit in "${EXPECTED_NEMORL_SHA}" "${EXPECTED_BRIDGE_SHA}" "${EXPECTED_MCORE_SHA}" "${EXPECTED_TE_SHA}" "${EXPECTED_TE_VERSION_BASE_SHA}"; do
      if [[ ! "${commit}" =~ ^[0-9a-f]{40}$ ]]; then
        echo "Expected source commits must be full lowercase hexadecimal SHAs" >&2
        exit 2
      fi
    done
  fi
  if [[ "${RUNTIME_PHASE}" == "attest" && "${TEST_ONLY}" != "1" ]]; then
    if [[ ! "${RUNTIME_STAGE_JOB_ID}" =~ ^[1-9][0-9]*$ ]]; then
      echo "RUNTIME_STAGE_JOB_ID must identify the completed stage job" >&2
      exit 2
    fi
    stage_job_record=${RUNTIME_STAGE_ROOT}/stage-job-id
    if [[ -L "${RUNTIME_STAGE_ROOT}" || ! -d "${RUNTIME_STAGE_ROOT}" ]]; then
      echo "Runtime stage root is missing or unsafe" >&2
      exit 2
    fi
    if [[ -L "${stage_job_record}" || ! -f "${stage_job_record}" ]] ||
       [[ "$(<"${stage_job_record}")" != "${RUNTIME_STAGE_JOB_ID}" ]]; then
      echo "Runtime stage job record is missing, unsafe, or mismatched" >&2
      exit 2
    fi
    stage_job_status=$(sacct -X -j "${RUNTIME_STAGE_JOB_ID}" \
      --format=State,ExitCode -n -P | awk 'NF {print; count += 1} END {if (count != 1) exit 2}') || {
      echo "Unable to resolve one authoritative runtime stage job" >&2
      exit 2
    }
    if [[ "${stage_job_status}" != "COMPLETED|0:0" ]]; then
      echo "Runtime stage job must be terminal COMPLETED with exit code 0:0" >&2
      exit 2
    fi
    if [[ -L "$(dirname "${RUNTIME_STAGE_MARKER}")" ]]; then
      echo "Runtime stage marker directory is unsafe" >&2
      exit 2
    fi
    if [[ -L "${RUNTIME_STAGE_MARKER}" || ! -f "${RUNTIME_STAGE_MARKER}" ]]; then
      echo "Runtime stage completion marker is missing or unsafe" >&2
      exit 2
    fi
    if [[ "$(sha256sum "${RUNTIME_STAGE_MARKER}" | awk '{print $1}')" != \
          "${RUNTIME_STAGE_MARKER_SHA256}" ]]; then
      echo "Runtime stage marker SHA256 mismatch" >&2
      exit 2
    fi
  fi
  export ACCOUNT ARTIFACT_DIR CONTAINER CONTAINER_RUNTIME_VALIDATOR
  export CONTAINER_SHA256 PARTITION PROJECT_ROOT SOURCE_PROVENANCE_VERIFIER
  export EXPECTED_NEMORL_SHA EXPECTED_BRIDGE_SHA EXPECTED_MCORE_SHA EXPECTED_TE_SHA
  export EXPECTED_TE_VERSION_BASE_SHA
  export RUNTIME_PHASE RUNTIME_STAGE_ROOT RUNTIME_STAGE_MARKER
  export RUNTIME_STAGE_MARKER_SHA256 RUNTIME_STAGE_JOB_ID NVTE_CUDA_ARCHS
  export TORCH_CUDA_ARCH_LIST RUNTIME_FEATURE_SET RUNTIME_EXCLUDED_PACKAGES
  export RUNTIME_STAGE_CAPABILITY RUNTIME_TEST_REQUIREMENTS RUNTIME_STAGE_CPUS_PER_TASK
  export SBATCH_GPUS_PER_NODE SBATCH_GRES
  export_spec=CONTAINER,CONTAINER_SHA256,ARTIFACT_DIR,CONTAINER_RUNTIME_VALIDATOR,PROJECT_ROOT,SOURCE_PROVENANCE_VERIFIER,EXPECTED_NEMORL_SHA,EXPECTED_BRIDGE_SHA,EXPECTED_MCORE_SHA,EXPECTED_TE_SHA,EXPECTED_TE_VERSION_BASE_SHA,RUNTIME_PHASE,RUNTIME_STAGE_ROOT,RUNTIME_STAGE_MARKER,RUNTIME_STAGE_MARKER_SHA256,RUNTIME_STAGE_JOB_ID,NVTE_CUDA_ARCHS,TORCH_CUDA_ARCH_LIST,RUNTIME_FEATURE_SET,RUNTIME_EXCLUDED_PACKAGES,RUNTIME_STAGE_CAPABILITY,RUNTIME_TEST_REQUIREMENTS,RUNTIME_STAGE_CPUS_PER_TASK,SBATCH_GPUS_PER_NODE=${SBATCH_GPUS_PER_NODE},SBATCH_GRES=${SBATCH_GRES},ACCOUNT,PARTITION,HOME,USER,LOGNAME,SHELL,PATH,LD_LIBRARY_PATH,HTTP_PROXY,HTTPS_PROXY,NO_PROXY,http_proxy,https_proxy,no_proxy
  submission_flag=--parsable
  if [[ "${SBATCH_TEST_ONLY}" == "1" ]]; then
    submission_flag=--test-only
  fi
  runtime_time_limit=00:15:00
  if [[ "${RUNTIME_PHASE}" == "stage" ]]; then
    runtime_time_limit=01:30:00
  fi
  sbatch_command=(
    sbatch
    "${submission_flag}"
    "--partition=${PARTITION}"
    "--account=${ACCOUNT}"
    "--job-name=${ACCOUNT}-cuda-graph.runtime-${RUNTIME_PHASE}"
    "--time=${runtime_time_limit}"
    "--output=${ARTIFACT_DIR}/oci-container-runtime-${RUNTIME_PHASE}-%j.log"
    "--export=${export_spec}"
    "${script_path}"
  )
  if [[ "${RUNTIME_PHASE}" == "stage" ]]; then
    sbatch_command[2]="--partition=${STAGE_PARTITION}"
    sbatch_command=("${sbatch_command[@]:0:4}" \
      "--cpus-per-task=${RUNTIME_STAGE_CPUS_PER_TASK}" "${sbatch_command[@]:4}")
  elif [[ "${SBATCH_GRES}" != "none" ]]; then
    sbatch_command=("${sbatch_command[@]:0:4}" \
      "--gres=${SBATCH_GRES}" "${sbatch_command[@]:4}")
  fi
  printf 'SBATCH:'
  printf ' %q' "${sbatch_command[@]}"
  printf '\n'
  printf 'RUNTIME_PHASE=%s\nRUNTIME_STAGE_ROOT=%s\nRUNTIME_STAGE_MARKER=%s\nRUNTIME_STAGE_MARKER_SHA256=%s\nRUNTIME_STAGE_CPUS_PER_TASK=%s\n' \
    "${RUNTIME_PHASE}" "${RUNTIME_STAGE_ROOT}" "${RUNTIME_STAGE_MARKER}" \
    "${RUNTIME_STAGE_MARKER_SHA256}" \
    "${RUNTIME_STAGE_CPUS_PER_TASK}"
  if [[ "${TEST_ONLY}" == "1" ]]; then
    echo "TEST_ONLY: no submission performed (local render only; scheduler not contacted)"
    exit 0
  fi
  if [[ "${SBATCH_TEST_ONLY}" != "1" ]]; then
    mkdir -p "${ARTIFACT_DIR}"
  fi
  sbatch_environment=(env)
  while IFS= read -r exported_name; do
    if [[ "${exported_name}" == SBATCH_* ]]; then
      sbatch_environment+=(-u "${exported_name}")
    fi
  done < <(compgen -e)
  "${sbatch_environment[@]}" "${sbatch_command[@]}"
  exit 0
fi

: "${CONTAINER_RUNTIME_VALIDATOR:?Submission must export CONTAINER_RUNTIME_VALIDATOR}"
if [[ "${CONTAINER_RUNTIME_VALIDATOR}" != /* || ! -f "${CONTAINER_RUNTIME_VALIDATOR}" ]]; then
  echo "CONTAINER_RUNTIME_VALIDATOR must be an existing absolute path" >&2
  exit 1
fi
if [[ -z "${PROJECT_ROOT:-}" ]]; then
  PROJECT_ROOT=$(cd "$(dirname "${CONTAINER_RUNTIME_VALIDATOR}")/../../.." && pwd -P)
fi
if [[ "${PROJECT_ROOT}" != /* || ! -f "${PROJECT_ROOT}/pyproject.toml" || ! -f "${PROJECT_ROOT}/uv.lock" || ! -f "${PROJECT_ROOT}/.python-version" || ! -f "${PROJECT_ROOT}/docker/Dockerfile" ]]; then
  echo "PROJECT_ROOT must be an absolute NeMo-RL checkout with pyproject.toml, uv.lock, .python-version, and docker/Dockerfile" >&2
  exit 1
fi
validator=${CONTAINER_RUNTIME_VALIDATOR}
validator=$(cd "$(dirname "${validator}")" && pwd -P)/$(basename "${validator}")
project_root=$(cd "${PROJECT_ROOT}" && pwd -P)
if [[ "${validator}" != "${project_root}/"* ]]; then
  echo "CONTAINER_RUNTIME_VALIDATOR must be inside PROJECT_ROOT" >&2
  exit 1
fi

unset PYTHONHOME PYTHONPATH VIRTUAL_ENV UV_PROJECT_ENVIRONMENT

if [[ -L "${CONTAINER}" ]]; then
  echo "Immutable container path must not be a symlink: ${CONTAINER}" >&2
  exit 1
fi
[[ -f "${CONTAINER}" ]] || {
  echo "Immutable container is missing: ${CONTAINER}" >&2
  exit 1
}
: "${EXPECTED_NEMORL_SHA:?Submission must export EXPECTED_NEMORL_SHA}"
: "${EXPECTED_BRIDGE_SHA:?Submission must export EXPECTED_BRIDGE_SHA}"
: "${EXPECTED_MCORE_SHA:?Submission must export EXPECTED_MCORE_SHA}"
: "${EXPECTED_TE_SHA:?Submission must export EXPECTED_TE_SHA}"
: "${EXPECTED_TE_VERSION_BASE_SHA:?Submission must export EXPECTED_TE_VERSION_BASE_SHA}"
: "${SOURCE_PROVENANCE_VERIFIER:?Submission must export SOURCE_PROVENANCE_VERIFIER}"
for commit in "${EXPECTED_NEMORL_SHA}" "${EXPECTED_BRIDGE_SHA}" "${EXPECTED_MCORE_SHA}" "${EXPECTED_TE_SHA}" "${EXPECTED_TE_VERSION_BASE_SHA}"; do
  if [[ ! "${commit}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "Expected source commits must be full lowercase hexadecimal SHAs" >&2
    exit 1
  fi
done
if [[ "${SOURCE_PROVENANCE_VERIFIER}" != /* || ! -x "${SOURCE_PROVENANCE_VERIFIER}" ]]; then
  echo "SOURCE_PROVENANCE_VERIFIER must be an existing absolute executable" >&2
  exit 1
fi
if [[ "${RUNTIME_PHASE}" == "stage" &&
      "${SLURM_CPUS_PER_TASK:-}" != "${RUNTIME_STAGE_CPUS_PER_TASK}" ]]; then
  echo "SLURM_CPUS_PER_TASK does not match RUNTIME_STAGE_CPUS_PER_TASK" >&2
  exit 1
fi
bridge_root=${project_root}/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge
mcore_root=${bridge_root}/3rdparty/Megatron-LM
"${SOURCE_PROVENANCE_VERIFIER}" \
  "${project_root}" "${EXPECTED_NEMORL_SHA}" \
  "${bridge_root}" "${EXPECTED_BRIDGE_SHA}" \
  "${mcore_root}" "${EXPECTED_MCORE_SHA}"
uv_lock_sha256=$(sha256sum "${project_root}/uv.lock" | awk '{print $1}')
actual_container_sha256=$(sha256sum "${CONTAINER}" | awk '{print $1}')
if [[ "${actual_container_sha256}" != "${CONTAINER_SHA256}" ]]; then
  echo "Immutable container SHA256 mismatch" >&2
  exit 1
fi
if stat --version >/dev/null 2>&1; then
  read -r container_device container_inode container_size \
    container_mtime_seconds container_ctime_seconds < <(
      stat -Lc '%d %i %s %Y %Z' -- "${CONTAINER}"
    )
else
  read -r container_device container_inode container_size \
    container_mtime_seconds container_ctime_seconds < <(
      stat -f '%d %i %z %m %c' "${CONTAINER}"
    )
fi
[[ -f "${validator}" ]] || {
  echo "Runtime probe is missing: ${validator}" >&2
  exit 1
}

mkdir -p "${ARTIFACT_DIR}"
mkdir -p "${ARTIFACT_DIR}/staged-runtimes"
expected_python_version=$(tr -d '[:space:]' <"${project_root}/.python-version")
if [[ ! "${expected_python_version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo ".python-version must contain one exact X.Y.Z version" >&2
  exit 1
fi
python_install_dir=${ARTIFACT_DIR%/}/uv-python-installations
if [[ -L "${python_install_dir}" || ( -e "${python_install_dir}" && ! -d "${python_install_dir}" ) ]]; then
  echo "Managed Python install directory is unsafe" >&2
  exit 1
fi
mkdir -p "${python_install_dir}"
expected_uv_version=$(sed -nE 's/^ARG UV_VERSION=([0-9]+\.[0-9]+\.[0-9]+)$/\1/p' "${project_root}/docker/Dockerfile")
if [[ ! "${expected_uv_version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "docker/Dockerfile must contain one exact ARG UV_VERSION=X.Y.Z pin" >&2
  exit 1
fi
runtime_stage_root=${RUNTIME_STAGE_ROOT:?Submission must export RUNTIME_STAGE_ROOT}
if [[ "${runtime_stage_root}" != "${ARTIFACT_DIR%/}/staged-runtimes/"* ]]; then
  echo "RUNTIME_STAGE_ROOT must be inside ARTIFACT_DIR/staged-runtimes" >&2
  exit 1
fi
runtime_stage_key=$(basename "${runtime_stage_root}")
runtime_stage_marker=${RUNTIME_STAGE_MARKER:?Submission must export RUNTIME_STAGE_MARKER}
if [[ "${runtime_stage_marker}" != \
      "${ARTIFACT_DIR%/}/stage-markers/${runtime_stage_key}.env" ]]; then
  echo "RUNTIME_STAGE_MARKER must be the keyed marker under ARTIFACT_DIR/stage-markers" >&2
  exit 1
fi
if [[ ! "${RUNTIME_STAGE_MARKER_SHA256:?Submission must export RUNTIME_STAGE_MARKER_SHA256}" =~ ^[0-9a-f]{64}$ ]]; then
  echo "RUNTIME_STAGE_MARKER_SHA256 must be 64 lowercase hexadecimal characters" >&2
  exit 1
fi
runtime_stage_job_id=${RUNTIME_STAGE_JOB_ID:-}
if [[ "${RUNTIME_PHASE}" == "stage" ]]; then
  runtime_stage_job_id=${SLURM_JOB_ID}
fi
if [[ ! "${runtime_stage_job_id}" =~ ^[1-9][0-9]*$ ]]; then
  echo "Runtime stage job ID must be a positive integer" >&2
  exit 1
fi
uv_bin_dir=${runtime_stage_root}/uv
uv_executable=${uv_bin_dir}/uv
artifact=${ARTIFACT_DIR}/oci-container-runtime-${SLURM_JOB_ID}.json
partial_artifact=${artifact}.partial
diagnostic=${ARTIFACT_DIR}/oci-container-runtime-${SLURM_JOB_ID}.diagnostics.log
current_link=${ARTIFACT_DIR}/oci-container-runtime-latest.json
partial_link=${current_link}.partial.${SLURM_JOB_ID}
if [[ -e "${artifact}" || -e "${diagnostic}" ]]; then
  echo "Immutable runtime artifact or diagnostic already exists for job ${SLURM_JOB_ID}" >&2
  exit 1
fi
rm -f "${partial_artifact}" "${partial_link}"

container_mounts="${project_root}:${project_root}:ro,${ARTIFACT_DIR}:${ARTIFACT_DIR}"
runtime_environment_root=${runtime_stage_root}/environment
runtime_uv_cache=${runtime_stage_root}/build-cache
runtime_te_cmake_dir=${runtime_stage_root}/te-cmake
runtime_site_packages=${runtime_environment_root}/lib/python3.13/site-packages
