#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:4
#SBATCH --mem=0
#SBATCH --partition=batch
#SBATCH --time=00:20:00
#SBATCH --job-name=validate_nightly_gpu_runtime

set -euo pipefail

: "${CONTAINER:?Set CONTAINER to the immutable Enroot image path}"
: "${CONTAINER_SHA256:?Set CONTAINER_SHA256 to the immutable image SHA256}"
: "${EXPECTED_SOURCE_COMMIT:?Set EXPECTED_SOURCE_COMMIT to the image source commit}"
: "${PROJECT_ROOT:?Set PROJECT_ROOT to the exact NeMo-RL checkout}"
: "${ARTIFACT_DIR:?Set ARTIFACT_DIR to an absolute shared-storage path}"

ACCOUNT=${ACCOUNT:-nemotron_sw_post}
PARTITION=${PARTITION:-batch}
TEST_ONLY=${TEST_ONLY:-0}
SBATCH_TEST_ONLY=${SBATCH_TEST_ONLY:-0}
EXPECTED_DEVICE_COUNT=${EXPECTED_DEVICE_COUNT:-4}
EXPECTED_PYTHON_VERSION=${EXPECTED_PYTHON_VERSION:-3.13.14}
EXPECTED_UV_VERSION=${EXPECTED_UV_VERSION:-0.11.28}
MCORE_PROJECT_ROOT=${MCORE_PROJECT_ROOT:-${PROJECT_ROOT}}

if [[ "${CONTAINER}" != /* || "${PROJECT_ROOT}" != /* || \
      "${MCORE_PROJECT_ROOT}" != /* || "${ARTIFACT_DIR}" != /* ]]; then
  echo "CONTAINER, PROJECT_ROOT, MCORE_PROJECT_ROOT, and ARTIFACT_DIR must be absolute paths" >&2
  exit 2
fi
if [[ ! "${CONTAINER_SHA256}" =~ ^[0-9a-f]{64}$ ]]; then
  echo "CONTAINER_SHA256 must be 64 lowercase hexadecimal characters" >&2
  exit 2
fi
if [[ ! "${EXPECTED_SOURCE_COMMIT}" =~ ^[0-9a-f]{40}$ ]]; then
  echo "EXPECTED_SOURCE_COMMIT must be a full lowercase commit SHA" >&2
  exit 2
fi
if [[ "${PARTITION}" != "batch" ]]; then
  echo "OCI GPU runtime validation requires PARTITION=batch" >&2
  exit 2
fi
if [[ ! "${EXPECTED_DEVICE_COUNT}" =~ ^[1-9][0-9]*$ ]]; then
  echo "EXPECTED_DEVICE_COUNT must be positive" >&2
  exit 2
fi
if [[ ! "${TEST_ONLY}" =~ ^[01]$ || ! "${SBATCH_TEST_ONLY}" =~ ^[01]$ ]]; then
  echo "TEST_ONLY and SBATCH_TEST_ONLY must be 0 or 1" >&2
  exit 2
fi
if [[ "${TEST_ONLY}" == "1" && "${SBATCH_TEST_ONLY}" == "1" ]]; then
  echo "TEST_ONLY and SBATCH_TEST_ONLY are mutually exclusive" >&2
  exit 2
fi

script_path=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")
probe=${PROJECT_ROOT}/experiments/cuda_graph/nemotron_thd_te_graph_20260731/nightly_gpu_runtime_probe.py

if [[ -z "${SLURM_JOB_ID:-}" ]]; then
  if [[ ! -f "${probe}" ]]; then
    echo "Runtime probe is missing: ${probe}" >&2
    exit 2
  fi
  if [[ ! -f "${MCORE_PROJECT_ROOT}/pyproject.toml" || \
        ! -f "${MCORE_PROJECT_ROOT}/uv.lock" || \
        ! -f "${MCORE_PROJECT_ROOT}/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge/3rdparty/Megatron-LM/pyproject.toml" ]]; then
    echo "MCORE_PROJECT_ROOT must be a full recursive NeMo-RL checkout" >&2
    exit 2
  fi
  export ACCOUNT ARTIFACT_DIR CONTAINER CONTAINER_SHA256 EXPECTED_DEVICE_COUNT
  export EXPECTED_PYTHON_VERSION EXPECTED_SOURCE_COMMIT EXPECTED_UV_VERSION PARTITION
  export MCORE_PROJECT_ROOT PROJECT_ROOT
  submission_flag=--parsable
  if [[ "${SBATCH_TEST_ONLY}" == "1" ]]; then
    submission_flag=--test-only
  fi
  sbatch_command=(
    sbatch
    "${submission_flag}"
    "--partition=${PARTITION}"
    "--account=${ACCOUNT}"
    "--gres=gpu:${EXPECTED_DEVICE_COUNT}"
    "--output=${ARTIFACT_DIR}/nightly-gpu-runtime-%j.log"
    --export=CONTAINER,CONTAINER_SHA256,EXPECTED_SOURCE_COMMIT,PROJECT_ROOT,MCORE_PROJECT_ROOT,ARTIFACT_DIR,ACCOUNT,PARTITION,EXPECTED_DEVICE_COUNT,EXPECTED_PYTHON_VERSION,EXPECTED_UV_VERSION,HOME,USER,LOGNAME,SHELL,PATH,LD_LIBRARY_PATH,HTTP_PROXY,HTTPS_PROXY,NO_PROXY,http_proxy,https_proxy,no_proxy
    "${script_path}"
  )
  printf 'SBATCH:'
  printf ' %q' "${sbatch_command[@]}"
  printf '\n'
  if [[ "${TEST_ONLY}" == "1" ]]; then
    echo "TEST_ONLY: no submission performed (local render only; scheduler not contacted)"
    exit 0
  fi
  if [[ "${SBATCH_TEST_ONLY}" != "1" ]]; then
    mkdir -p "${ARTIFACT_DIR}"
  fi
  "${sbatch_command[@]}"
  exit 0
fi

if [[ -L "${CONTAINER}" || ! -f "${CONTAINER}" ]]; then
  echo "CONTAINER must be an existing immutable non-symlink image" >&2
  exit 1
fi
if [[ ! -f "${probe}" ]]; then
  echo "Runtime probe is missing: ${probe}" >&2
  exit 1
fi
if [[ ! -f "${MCORE_PROJECT_ROOT}/pyproject.toml" || \
      ! -f "${MCORE_PROJECT_ROOT}/uv.lock" || \
      ! -f "${MCORE_PROJECT_ROOT}/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge/3rdparty/Megatron-LM/pyproject.toml" ]]; then
  echo "MCORE_PROJECT_ROOT must be a full recursive NeMo-RL checkout" >&2
  exit 1
fi

result=${ARTIFACT_DIR}/nightly-gpu-runtime-${SLURM_JOB_ID}.json
partial_result=${result}.partial
if [[ -e "${result}" || -e "${partial_result}" ]]; then
  echo "Runtime result already exists for job ${SLURM_JOB_ID}" >&2
  exit 1
fi

mkdir -p "${ARTIFACT_DIR}"
trap 'rm -f "${partial_result}"' EXIT
unset PYTHONHOME PYTHONPATH VIRTUAL_ENV UV_PROJECT_ENVIRONMENT
container_mounts="${PROJECT_ROOT}:${PROJECT_ROOT}:ro,${ARTIFACT_DIR}:${ARTIFACT_DIR}"
if [[ "${MCORE_PROJECT_ROOT}" != "${PROJECT_ROOT}" ]]; then
  container_mounts+=",${MCORE_PROJECT_ROOT}:${MCORE_PROJECT_ROOT}:ro"
fi
runtime_stage_root="/tmp/nemo-rl-nightly-mcore-smoke-${SLURM_JOB_ID}"
runtime_project_root="${runtime_stage_root}/source"
runtime_environment_root="${runtime_stage_root}/environment"
runtime_payload='set -euo pipefail
source_project_root=$1
runtime_stage_root=$2
runtime_project_root=$3
shift 3
if [[ -e "${runtime_stage_root}" || -L "${runtime_stage_root}" ]]; then
  echo "Job-local runtime stage already exists: ${runtime_stage_root}" >&2
  exit 2
fi
cleanup_runtime_stage() {
  chmod -R u+w -- "${runtime_stage_root}" 2>/dev/null || true
  rm -rf -- "${runtime_stage_root}"
}
trap cleanup_runtime_stage EXIT
mkdir -m 0700 -- "${runtime_stage_root}"
mkdir -m 0700 -- "${runtime_project_root}" "${UV_PROJECT_ENVIRONMENT}" \
  "${HOME}" "${TMPDIR}"
mkdir -p -- "${UV_CACHE_DIR}"
cp -a -- "${source_project_root}/." "${runtime_project_root}/"
if [[ ! -f "${runtime_project_root}/pyproject.toml" || \
      ! -f "${runtime_project_root}/uv.lock" || \
      ! -f "${runtime_project_root}/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge/3rdparty/Megatron-LM/pyproject.toml" ]]; then
  echo "Job-local MCore source copy is incomplete" >&2
  exit 2
fi
/root/.local/bin/uv run \
  --locked \
  --extra mcore \
  --no-python-downloads \
  --directory "${runtime_project_root}" \
  "$@"'
runtime_environment=(
  /usr/bin/env
  "HOME=${runtime_stage_root}/home"
  CUDA_HOME=/usr/local/cuda
  CUDACXX=/usr/local/cuda/bin/nvcc
  CPLUS_INCLUDE_PATH=/usr/local/cuda/include/cccl
  NVTE_CUDA_ARCHS=100a
  NVTE_WITH_NCCL_EP=0
  "TMPDIR=${runtime_stage_root}/tmp"
  TORCH_CUDA_ARCH_LIST=10.0a
  UV_CACHE_DIR=/root/.cache/uv
  UV_LINK_MODE=copy
  UV_MANAGED_PYTHON=1
  "UV_PROJECT_ENVIRONMENT=${runtime_environment_root}"
  "UV_PYTHON=${EXPECTED_PYTHON_VERSION}"
  UV_PYTHON_DOWNLOADS=never
  UV_PYTHON_INSTALL_DIR=/root/.local/share/uv/python
)
for proxy_variable in HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do
  if [[ -n "${!proxy_variable:-}" ]]; then
    runtime_environment+=("${proxy_variable}=${!proxy_variable}")
  fi
done
srun \
  --nodes=1 \
  --ntasks=1 \
  "--gres=gpu:${EXPECTED_DEVICE_COUNT}" \
  --no-container-mount-home \
  --container-writable \
  --container-image="${CONTAINER}" \
  --container-mounts="${container_mounts}" \
  --export=NIL \
  "${runtime_environment[@]}" \
  /bin/bash -c "${runtime_payload}" bash \
    "${MCORE_PROJECT_ROOT}" \
    "${runtime_stage_root}" \
    "${runtime_project_root}" \
    python "${probe}" \
    --expected-device-count "${EXPECTED_DEVICE_COUNT}" \
    --expected-python-version "${EXPECTED_PYTHON_VERSION}" \
    --expected-source-commit "${EXPECTED_SOURCE_COMMIT}" \
    --expected-uv-version "${EXPECTED_UV_VERSION}" \
    --output "${partial_result}"
mv "${partial_result}" "${result}"
trap - EXIT
printf 'runtime_result=%s\n' "${result}"
