#SBATCH --nodes=1
#SBATCH --exclusive
#SBATCH --partition=batch
#SBATCH --time=04:00:00
#SBATCH --job-name=nemorl_cg_scope

set -euo pipefail

: "${COMMAND:?run_scope.sh must export COMMAND}"
: "${CONTAINER:?run_scope.sh must export CONTAINER}"
: "${CONTAINER_SHA256:?run_scope.sh must export CONTAINER_SHA256}"
: "${MOUNTS:?run_scope.sh must export MOUNTS}"
: "${RUNTIME_ATTESTATION_COMMAND:?run_scope.sh must export RUNTIME_ATTESTATION_COMMAND}"
: "${REPO_ROOT:?run_scope.sh must export REPO_ROOT}"
: "${EXPECTED_NEMORL_SHA:?run_scope.sh must export EXPECTED_NEMORL_SHA}"
: "${EXPECTED_BRIDGE_SHA:?run_scope.sh must export EXPECTED_BRIDGE_SHA}"
: "${EXPECTED_MCORE_SHA:?run_scope.sh must export EXPECTED_MCORE_SHA}"
: "${SOURCE_PROVENANCE_VERIFIER:?run_scope.sh must export SOURCE_PROVENANCE_VERIFIER}"
: "${PINNED_UV_VERSION:?run_scope.sh must export PINNED_UV_VERSION}"
: "${UV_EXECUTABLE:?run_scope.sh must export UV_EXECUTABLE}"
: "${RUNTIME_PYTHON:?run_scope.sh must export RUNTIME_PYTHON}"
: "${UV_PYTHON:?run_scope.sh must export UV_PYTHON}"
: "${UV_PYTHON_INSTALL_DIR:?run_scope.sh must export UV_PYTHON_INSTALL_DIR}"
: "${UV_MANAGED_PYTHON:?run_scope.sh must export UV_MANAGED_PYTHON}"
: "${UV_PYTHON_DOWNLOADS:?run_scope.sh must export UV_PYTHON_DOWNLOADS}"
: "${NVTE_WITH_NCCL_EP:?run_scope.sh must export NVTE_WITH_NCCL_EP}"
: "${BASE_LOG_DIR:?run_scope.sh must export BASE_LOG_DIR}"
[[ "${NVTE_WITH_NCCL_EP}" == "0" ]] || {
  echo "NVTE_WITH_NCCL_EP must be 0 for the HybridEP partial-CUDA-Graph study" >&2
  exit 2
}
export NVTE_WITH_NCCL_EP

expected_python_version=$(tr -d '[:space:]' <"${REPO_ROOT}/.python-version")
[[ "${UV_PYTHON}" == "${expected_python_version}" ]] || {
  echo "UV_PYTHON must match ${REPO_ROOT}/.python-version" >&2
  exit 2
}
[[ "${UV_PYTHON_INSTALL_DIR}" == /* ]] || {
  echo "UV_PYTHON_INSTALL_DIR must be absolute" >&2
  exit 2
}
[[ "${UV_MANAGED_PYTHON}" == "1" ]] || {
  echo "UV_MANAGED_PYTHON must be 1" >&2
  exit 2
}
[[ "${UV_PYTHON_DOWNLOADS}" == "never" ]] || {
  echo "UV_PYTHON_DOWNLOADS must be never" >&2
  exit 2
}
expected_uv_version=$(sed -nE 's/^ARG UV_VERSION=([0-9]+\.[0-9]+\.[0-9]+)$/\1/p' "${REPO_ROOT}/docker/Dockerfile")
[[ "${PINNED_UV_VERSION}" == "${expected_uv_version}" ]] || {
  echo "PINNED_UV_VERSION must match ${REPO_ROOT}/docker/Dockerfile" >&2
  exit 2
}
[[ "${UV_EXECUTABLE}" == /* && -x "${UV_EXECUTABLE}" && ! -L "${UV_EXECUTABLE}" && ! -L "$(dirname "${UV_EXECUTABLE}")" ]] || {
  echo "UV_EXECUTABLE must be an absolute, executable, non-symlink path" >&2
  exit 2
}
uv_suffix=/uv/uv
if [[ "${UV_EXECUTABLE}" != *"${uv_suffix}" ]]; then
  echo "UV_EXECUTABLE must use the staged-runtimes/<sha256>/uv/uv layout" >&2
  exit 2
fi
runtime_stage_root=${UV_EXECUTABLE%"${uv_suffix}"}
runtime_stage_key=${runtime_stage_root##*/}
runtime_stage_parent=${runtime_stage_root%/*}
if [[ "${runtime_stage_parent##*/}" != "staged-runtimes" ||
      ${#runtime_stage_key} -ne 64 || "${runtime_stage_key}" =~ [^0-9a-f] ]]; then
  echo "UV_EXECUTABLE must use the staged-runtimes/<sha256>/uv/uv layout" >&2
  exit 2
fi
runtime_environment_root=${runtime_stage_root}/environment
expected_runtime_python=${runtime_environment_root}/bin/python
if [[ "${RUNTIME_PYTHON}" != "${expected_runtime_python}" ||
      ! -f "${RUNTIME_PYTHON}" || ! -x "${RUNTIME_PYTHON}" ||
      -L "${runtime_environment_root}" ]]; then
  echo "RUNTIME_PYTHON must be the executable staged environment Python" >&2
  exit 2
fi
resolved_runtime_python=$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${RUNTIME_PYTHON}")
resolved_python_install_dir=$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${UV_PYTHON_INSTALL_DIR}")
case "${resolved_runtime_python}" in
  "${resolved_python_install_dir}"/*) ;;
  *)
    echo "RUNTIME_PYTHON must resolve inside UV_PYTHON_INSTALL_DIR" >&2
    exit 2
    ;;
esac
if [[ "${BASE_LOG_DIR}" != /* || "${BASE_LOG_DIR}" == *:* || "${BASE_LOG_DIR}" == *$'\n'* ]]; then
  echo "BASE_LOG_DIR must be an absolute path without colons or newlines" >&2
  exit 2
fi

bridge_root=${REPO_ROOT}/3rdparty/Megatron-Bridge-workspace/Megatron-Bridge
mcore_root=${bridge_root}/3rdparty/Megatron-LM
"${SOURCE_PROVENANCE_VERIFIER}" \
  "${REPO_ROOT}" "${EXPECTED_NEMORL_SHA}" \
  "${bridge_root}" "${EXPECTED_BRIDGE_SHA}" \
  "${mcore_root}" "${EXPECTED_MCORE_SHA}"

CONTAINER_PATH_PREFIX=$(dirname "${UV_EXECUTABLE}")
case "${CONTAINER_PATH_PREFIX}" in
  *:*|*$'\n'*)
    echo "CONTAINER_PATH_PREFIX must not contain a colon or newline" >&2
    exit 2
    ;;
esac
export CONTAINER_PATH_PREFIX
unset PYTHONHOME PYTHONPATH VIRTUAL_ENV
export UV_PROJECT_ENVIRONMENT=${runtime_environment_root}
export UV_LINK_MODE=copy
export UV_NO_EDITABLE=1
export NVTE_CUDA_ARCHS=100a
export TORCH_CUDA_ARCH_LIST=10.0a
export CMAKE_BUILD_PARALLEL_LEVEL=32
export NRL_SLURM_JOB_ID=${SLURM_JOB_ID:?}
export NRL_SLURM_RESTART_COUNT=${SLURM_RESTART_COUNT:-0}
export NEMO_RL_VENV_DIR=/tmp/nemo-rl-worker-venvs/job-${NRL_SLURM_JOB_ID}-restart-${NRL_SLURM_RESTART_COUNT}
export UV_PROJECT=/tmp/nemo-rl-worker-projects/job-${NRL_SLURM_JOB_ID}-restart-${NRL_SLURM_RESTART_COUNT}/source
export RUNTIME_PYTHON
CONTAINER_ENV_VARS=CONTAINER_PATH_PREFIX,UV_PROJECT,UV_PROJECT_ENVIRONMENT,UV_LINK_MODE,UV_PYTHON,UV_PYTHON_INSTALL_DIR,UV_MANAGED_PYTHON,UV_PYTHON_DOWNLOADS,UV_NO_EDITABLE,PINNED_UV_VERSION,UV_EXECUTABLE,RUNTIME_PYTHON,NEMO_RL_VENV_DIR,NRL_FORCE_REBUILD_VENVS,NVTE_WITH_NCCL_EP,NVTE_CUDA_ARCHS,TORCH_CUDA_ARCH_LIST,CMAKE_BUILD_PARALLEL_LEVEL,NRL_SLURM_JOB_ID,NRL_SLURM_RESTART_COUNT
export CONTAINER_ENV_VARS
managed_python_setup_command='set -euo pipefail
umask 077
managed_python=$("${UV_EXECUTABLE}" python find --managed-python "${UV_PYTHON}")
case "${managed_python}" in
  "${UV_PYTHON_INSTALL_DIR}"/*) ;;
  *)
    echo "Managed Python resolved outside UV_PYTHON_INSTALL_DIR: ${managed_python}" >&2
    exit 2
    ;;
esac
actual_python_version=$("${managed_python}" -c "import platform; print(platform.python_version())")
if [[ "${actual_python_version}" != "${UV_PYTHON}" ]]; then
  echo "Managed Python version mismatch: expected ${UV_PYTHON}, got ${actual_python_version}" >&2
  exit 2
fi
if [[ "${RUNTIME_PYTHON}" != "${UV_PROJECT_ENVIRONMENT}/bin/python" ||
      ! -f "${RUNTIME_PYTHON}" || ! -x "${RUNTIME_PYTHON}" ]]; then
  echo "Shared runtime Python is unavailable on this Ray node" >&2
  exit 2
fi
runtime_python_version=$("${RUNTIME_PYTHON}" -c "import platform; print(platform.python_version())")
if [[ "${runtime_python_version}" != "${UV_PYTHON}" ]]; then
  echo "Runtime Python version mismatch: expected ${UV_PYTHON}, got ${runtime_python_version}" >&2
  exit 2
fi
if [[ "${UV_NO_EDITABLE}" != "1" ]]; then
  echo "UV_NO_EDITABLE must be 1 for immutable runtime source" >&2
  exit 2
fi
runtime_stage_root=${UV_EXECUTABLE%/uv/uv}
source_project_root=${runtime_stage_root}/source
project_parent=$(dirname "${UV_PROJECT}")
if [[ "${UV_PROJECT}" != "/tmp/nemo-rl-worker-projects/job-${NRL_SLURM_JOB_ID}-restart-${NRL_SLURM_RESTART_COUNT}/source" ||
      -e "${project_parent}" || -L "${project_parent}" ]]; then
  echo "UV_PROJECT must select a fresh job- and restart-isolated build view" >&2
  exit 2
fi
mkdir -m 0700 -p -- "${project_parent}"
mkdir -m 0700 -- "${UV_PROJECT}"
tar --exclude="./.git" --exclude="*/.git" --exclude="*.egg-info" \
  -C "${source_project_root}" -cf - . | tar -C "${UV_PROJECT}" -xf -
diff -qr --no-dereference --exclude=.git --exclude="*.egg-info" \
  "${source_project_root}" "${UV_PROJECT}"
chmod -R u+w -- "${UV_PROJECT}"
mkdir -p "${NEMO_RL_VENV_DIR}"
[[ -d "${NEMO_RL_VENV_DIR}" && -w "${NEMO_RL_VENV_DIR}" ]] || {
  echo "NEMO_RL_VENV_DIR is not a writable shared directory" >&2
  exit 2
}'
if [[ -n "${SETUP_COMMAND:-}" ]]; then
  SETUP_COMMAND=${managed_python_setup_command}$'\n'${SETUP_COMMAND}
else
  SETUP_COMMAND=${managed_python_setup_command}
fi
export SETUP_COMMAND

export SLURM_EXPORT_ENV=ALL
srun \
  --nodes=1 \
  --ntasks=1 \
  --no-container-mount-home \
  --container-image="${CONTAINER}" \
  --container-mounts="${MOUNTS}" \
  --container-workdir="${REPO_ROOT}" \
  "--container-env=${CONTAINER_ENV_VARS}" \
  --export=ALL \
  /bin/bash --noprofile --norc -c "${RUNTIME_ATTESTATION_COMMAND}"

# The allocation is created from this wrapper, so ray.sub's embedded SBATCH
# comments are inert. Its mature Ray lifecycle remains the runtime implementation.
exec bash "${REPO_ROOT}/ray.sub"
