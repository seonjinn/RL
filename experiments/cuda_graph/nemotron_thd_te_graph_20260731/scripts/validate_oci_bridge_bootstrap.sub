#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:4
#SBATCH --partition=batch
#SBATCH --time=02:00:00
#SBATCH --job-name=bridge_recipe_bootstrap

set -euo pipefail

: "${BRIDGE_REPOSITORY:?Set BRIDGE_REPOSITORY to a fetchable Megatron-Bridge repository}"
: "${EXPECTED_BRIDGE_SHA:?Set EXPECTED_BRIDGE_SHA to the exact Bridge commit}"
: "${EXPECTED_MCORE_SHA:?Set EXPECTED_MCORE_SHA to the exact nested MCore commit}"
: "${ARTIFACT_DIR:?Set ARTIFACT_DIR to an absolute shared-storage path}"
: "${CONTAINER:?Set CONTAINER to the immutable nightly squashfs path}"
: "${CONTAINER_SHA256:?Set CONTAINER_SHA256 to the squashfs SHA256}"

ACCOUNT=${ACCOUNT:-coreai_dlalgo_nemorl}
PARTITION=${PARTITION:-batch}
MOUNTS=${MOUNTS:-/lustre:/lustre}
TEST_ONLY=${TEST_ONLY:-0}

if [[ ! "${EXPECTED_BRIDGE_SHA}" =~ ^[[:xdigit:]]{40}$ ]]; then
  echo "EXPECTED_BRIDGE_SHA must be a full 40-character commit" >&2
  exit 2
fi
if [[ ! "${EXPECTED_MCORE_SHA}" =~ ^[[:xdigit:]]{40}$ ]]; then
  echo "EXPECTED_MCORE_SHA must be a full 40-character commit" >&2
  exit 2
fi
if [[ ! "${CONTAINER_SHA256}" =~ ^[[:xdigit:]]{64}$ ]]; then
  echo "CONTAINER_SHA256 must contain 64 hexadecimal characters" >&2
  exit 2
fi
if [[ "${ARTIFACT_DIR}" != /* || "${CONTAINER}" != /* ]]; then
  echo "ARTIFACT_DIR and CONTAINER must be absolute paths" >&2
  exit 2
fi
if [[ "${PARTITION}" != "batch" ]]; then
  echo "Production validation requires PARTITION=batch" >&2
  exit 2
fi
if [[ "${BRIDGE_REPOSITORY}" =~ ^https?://[^/]*:[^/]*@ ]]; then
  echo "BRIDGE_REPOSITORY must not contain embedded credentials" >&2
  exit 2
fi

script_path=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")

if [[ -z "${SLURM_JOB_ID:-}" ]]; then
  sbatch_command=(
    sbatch
    --parsable
    "--partition=${PARTITION}"
    "--account=${ACCOUNT}"
    --gres=gpu:4
    "--output=${ARTIFACT_DIR}/slurm-%j.log"
    --export=ALL
    "${script_path}"
  )
  printf 'EXPECTED_BRIDGE_SHA=%s\n' "${EXPECTED_BRIDGE_SHA}"
  printf 'EXPECTED_MCORE_SHA=%s\n' "${EXPECTED_MCORE_SHA}"
  printf 'CONTAINER_SHA256=%s\n' "${CONTAINER_SHA256}"
  printf 'SBATCH:'
  printf ' %q' "${sbatch_command[@]}"
  printf '\n'
  if [[ "${TEST_ONLY}" == "1" ]]; then
    echo "TEST_ONLY: no submission performed"
    exit 0
  fi
  mkdir -p "${ARTIFACT_DIR}"
  "${sbatch_command[@]}"
  exit 0
fi

if [[ ! -f "${CONTAINER}" ]]; then
  echo "Immutable container is missing: ${CONTAINER}" >&2
  exit 1
fi
actual_container_sha=$(sha256sum "${CONTAINER}" | awk '{print $1}')
if [[ "${actual_container_sha}" != "${CONTAINER_SHA256}" ]]; then
  echo "Container SHA256 mismatch: expected ${CONTAINER_SHA256}, got ${actual_container_sha}" >&2
  exit 1
fi

payload=$(dirname "${script_path}")/bridge_bootstrap_payload.sh
export SLURM_EXPORT_ENV=ALL
srun \
  --nodes=1 \
  --ntasks=1 \
  --container-image="${CONTAINER}" \
  --container-mounts="${MOUNTS}" \
  --export=ALL \
  bash "${payload}"
