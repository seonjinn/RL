# GB200 OCI-HSG profile. Task 5 replaces this stable symlink with the immutable
# staged image after recording its digest and SHA256 provenance.
ACCOUNT=coreai_dlalgo_nemorl
PARTITION=batch
CONTAINER=/lustre/fs1/portfolios/coreai/projects/coreai_dlalgo_nemorl/users/sna/nemo-rl/nemo_rl_latestmain_nanov3.sqsh
HF_HOME=/lustre/fs1/portfolios/coreai/projects/coreai_dlalgo_nemorl/users/sna/hf_home
HF_DATASETS_CACHE=/lustre/fs1/portfolios/coreai/projects/coreai_dlalgo_nemorl/users/sna/hf_home/cache
NANOV3_MODEL_SNAPSHOT=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-Base-BF16
NANOV3_TOKENIZER_SNAPSHOT=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16
MOUNTS=/lustre:/lustre
NUM_ACTOR_NODES=4
GPUS_PER_NODE=4
SEGMENT_SIZE=4
TIME_LIMIT=04:00:00

# OCI-HSG's batch partition accepts the GRES request form used by its existing
# NeMo-RL launchers.
SBATCH_GPU_ARGS=(--gres=gpu:4)
