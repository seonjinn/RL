# GB200 Ptyche profile. Task 5 replaces this stable symlink with the immutable
# staged image after recording its digest and SHA256 provenance.
ACCOUNT=coreai_dlalgo_llm
PARTITION=batch
CONTAINER=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg/containers/nemo_rl_latestmain_nanov3.sqsh
HF_HOME=/lustre/fsw/coreai_dlalgo_llm/users/sna/hf_home
HF_DATASETS_CACHE=/lustre/fsw/coreai_dlalgo_llm/users/sna/hf_home/cache
MOUNTS=/lustre:/lustre
NUM_ACTOR_NODES=4
GPUS_PER_NODE=4
SEGMENT_SIZE=4
TIME_LIMIT=04:00:00

# Ptyche rejects the legacy --gres=gpu:<count> request form. Keep the request
# owned by the profile so the scope scripts remain portable and easy to diff.
SBATCH_GPU_ARGS=(--gpus-per-node=4)
