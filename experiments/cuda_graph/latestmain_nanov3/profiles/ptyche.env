# GB200 Ptyche profile. Task 5 validated the immutable nightly artifact behind
# this stable link; its digest and SHA256 are recorded in the result provenance.
ACCOUNT=coreai_dlalgo_llm
PARTITION=batch
CONTAINER=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg/containers/nemo_rl_nightly.sqsh
HF_HOME=/lustre/fsw/coreai_dlalgo_llm/users/sna/hf_home
HF_DATASETS_CACHE=/lustre/fsw/coreai_dlalgo_llm/users/sna/hf_home/cache
NANOV3_MODEL_SNAPSHOT=/lustre/fsw/coreai_dlalgo_llm/users/sna/hf_home/hub/models--nvidia--NVIDIA-Nemotron-3-Nano-30B-A3B-Base-BF16/snapshots/97ab8012882a655dc38df4fee47422aca9caca07
MOUNTS=/lustre:/lustre

# Keep uv's downloaded wheels and Transformer Engine build artifacts on Lustre
# while NRL_FORCE_REBUILD_VENVS=true continues to rebuild each job environment.
# Every immutable input that can invalidate the cache has its own path segment.
export UV_CACHE_DIR_OVERRIDE=/lustre/fsw/coreai_dlalgo_llm/users/sna/nemo-rl-cg/uv_cache/linux-aarch64-cp313/image-67ad116cb0a969ad2644869a4d0e2e3c5d7a859588dd1789dc25732ef3700dba/nemo-rl-21efc14f84d243f0ce7a23442cf4e57c01418383/bridge-59c163cce9cb8cc209dcd0424b2b9de9d1be5027/mcore-53f5161ce000b5320bc16cb260949c2e6808da83/uv-lock-30a35a07db7a646a7e0fb4e458daf264cf6c805a

NUM_ACTOR_NODES=4
GPUS_PER_NODE=4
SEGMENT_SIZE=4
TIME_LIMIT=04:00:00

# Ptyche's batch partition allocates whole GB200 nodes; both GRES and
# --gpus-per-node are rejected by its live scheduler. ray.sub is exclusive.
SBATCH_GPU_ARGS=()
