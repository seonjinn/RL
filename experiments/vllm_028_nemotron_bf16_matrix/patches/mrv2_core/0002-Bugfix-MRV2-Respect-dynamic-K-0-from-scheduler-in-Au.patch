index fc4f78a..718389c 100644
--- a/vllm/v1/worker/gpu/spec_decode/speculator.py
+++ b/vllm/v1/worker/gpu/spec_decode/speculator.py
@@ -65,6 +65,7 @@ class BaseSpeculator(ABC):
