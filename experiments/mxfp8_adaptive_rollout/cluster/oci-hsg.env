# OCI-HSG GB200 profile. Override any value explicitly in the environment.
export CLUSTER_ID="oci-hsg"
export SSH_HOST="${SSH_HOST:-oci-hsg}"
export SLURM_ACCOUNT="${SLURM_ACCOUNT:-${ACCOUNT:-coreai_dlalgo_nemorl}}"
export PARTITION="${PARTITION:-batch}"
export QOS="${QOS:-normal}"
export NUM_NODES="${NUM_NODES:-4}"
export GPUS_PER_NODE="${GPUS_PER_NODE:-4}"
export SLURM_SWITCHES="${SLURM_SWITCHES:-1@600}"
export WALLTIME="${WALLTIME:-04:00:00}"

export USER_LUSTRE_ROOT="${USER_LUSTRE_ROOT:-/lustre/fsw/portfolios/coreai/users/${USER}}"
export NEMO_RL_REPO_ROOT="${NEMO_RL_REPO_ROOT:-${USER_LUSTRE_ROOT}/nemo-rl-mxfp8-adaptive-main}"
export CONTAINER_ROOT="${CONTAINER_ROOT:-${USER_LUSTRE_ROOT}/containers}"
export NEMO_RL_EXPERIMENT_ROOT="${NEMO_RL_EXPERIMENT_ROOT:-${USER_LUSTRE_ROOT}/experiments/mxfp8_adaptive_rollout}"
export HF_HOME="${HF_HOME:-${USER_LUSTRE_ROOT}/hf_home}"
export CACHE_ROOT="${CACHE_ROOT:-${USER_LUSTRE_ROOT}/.cache/mxfp8_adaptive_rollout}"
export CONTAINER_MOUNTS="${CONTAINER_MOUNTS:-/lustre:/lustre,/scratch:/scratch}"

# Launchers require an immutable, non-symlink .sqsh produced by
# scripts/stage_enroot_image.sbatch. Set this after staging.
export CONTAINER_IMAGE="${CONTAINER_IMAGE:-}"
