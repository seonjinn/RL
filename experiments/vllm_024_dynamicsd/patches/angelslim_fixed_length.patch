+def fit_input_ids(input_ids: torch.Tensor, input_length: int) -> torch.Tensor:
+    if input_length <= 0:
+        raise ValueError("--input-length must be positive")
+    current_length = input_ids.shape[1]
+    if current_length == 0:
+        raise ValueError("tokenizer returned an empty prompt")
+    repeats = (input_length + current_length - 1) // current_length
+    return input_ids.repeat(1, repeats)[:, :input_length]
 
 
