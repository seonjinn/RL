#!/bin/bash
# Sourced after common.env by the two dedicated functional wrappers.
: "${NRL_REFIT_SLEEP_ARTIFACT_DIR:?set a new durable experiment directory}"
: "${NRL_REFIT_SLEEP_EXPECTED_SHA:?set the exact committed source SHA}"
: "${NRL_REFIT_SLEEP_IMAGE:?set the immutable nightly image identity}"
: "${NRL_REFIT_SLEEP_IMAGE_DIGEST:?set sha256 digest of image or sqsh bytes}"
[[ "$NRL_REFIT_SLEEP_ARTIFACT_DIR" == /lustre/* ]] || exit 2
[[ "$NRL_REFIT_SLEEP_CACHE_ROOT" == /raid/scratch/* ]] || exit 2

refit_sleep_wandb_name=
refit_sleep_git_meta=
refit_sleep_container=
for argument in "$@"; do
    case "$argument" in
        logger.wandb.name=*)
            value=${argument#*=}
            target=refit_sleep_wandb_name
            ;;
        ++git_meta=*)
            value=${argument#*=}
            target=refit_sleep_git_meta
            ;;
        ++container=*)
            value=${argument#*=}
            target=refit_sleep_container
            ;;
        *)
            echo "This wrapper accepts only tools/launch provenance arguments" >&2
            exit 2
            ;;
    esac
    if [[ -z "$value" || -n "${!target}" ]]; then
        echo "Invalid or duplicate tools/launch provenance argument: $argument" >&2
        exit 2
    fi
    printf -v "$target" %s "$value"
done
export NRL_REFIT_SLEEP_LAUNCH_WANDB_NAME=$refit_sleep_wandb_name
export NRL_REFIT_SLEEP_LAUNCH_GIT_META=$refit_sleep_git_meta
export NRL_REFIT_SLEEP_LAUNCH_CONTAINER=$refit_sleep_container
set --

export NRL_REFIT_SLEEP_RUN=1
export NRL_REFIT_SLEEP_RUN_DIR="$EXP_DIR"
export NRL_REFIT_SLEEP_DEADLINE_S=${NRL_REFIT_SLEEP_DEADLINE_S:-600}
export HF_HOME="$NRL_REFIT_SLEEP_CACHE_ROOT/hf"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export HF_MODULES_CACHE="$HF_HOME/modules"
export UV_CACHE_DIR="$NRL_REFIT_SLEEP_CACHE_ROOT/uv"
export XDG_CACHE_HOME="$NRL_REFIT_SLEEP_CACHE_ROOT/xdg"
export TORCH_HOME="$NRL_REFIT_SLEEP_CACHE_ROOT/torch"
export TORCH_EXTENSIONS_DIR="$NRL_REFIT_SLEEP_CACHE_ROOT/torch-extensions"
export TORCHINDUCTOR_CACHE_DIR="$NRL_REFIT_SLEEP_CACHE_ROOT/inductor"
export TRITON_CACHE_DIR="$NRL_REFIT_SLEEP_CACHE_ROOT/triton"
export VLLM_CACHE_ROOT="$NRL_REFIT_SLEEP_CACHE_ROOT/vllm"
export CUDA_CACHE_PATH="$NRL_REFIT_SLEEP_CACHE_ROOT/cuda"
export TMPDIR="$NRL_REFIT_SLEEP_CACHE_ROOT/tmp"
# Set the same RAY_TMPDIR before launching ray.sub so daemon logs are node-local too.
export RAY_TMPDIR="$NRL_REFIT_SLEEP_CACHE_ROOT/ray"
mkdir -p "$NRL_REFIT_SLEEP_ARTIFACT_DIR" "$TMPDIR"

collect_refit_sleep_logs() {
    local status=$?
    trap - EXIT
    timeout 150 uv run --no-sync python tests/functional/refit_sleep_runtime.py archive || status=1
    tar -czf "$NRL_REFIT_SLEEP_ARTIFACT_DIR/driver.tar.gz" -C "$EXP_DIR" . || status=1
    exit "$status"
}
trap collect_refit_sleep_logs EXIT

cd "$PROJECT_ROOT"
uv run --no-sync python tests/functional/refit_sleep_runtime.py record
