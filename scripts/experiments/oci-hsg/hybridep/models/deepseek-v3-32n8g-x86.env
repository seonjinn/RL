export NCCL_NVLS_ENABLE=0

MODEL_ID=deepseek-v3-32n8g-x86
CONFIG_PATH=examples/configs/recipes/llm/performance/grpo-deepseek-v3-32n8g-alltoall.yaml
DISPATCHER_MODE=recipe
NRL_FORCE_REBUILD_VENVS=false
MODEL_TOKENIZER_OVERRIDE_ENV=NRL_DEEPSEEK_V3_BF16_CKPT
NUM_ACTOR_NODES=${NUM_ACTOR_NODES:-32}
GPUS_PER_NODE=${GPUS_PER_NODE:-8}
SEGMENT_SIZE=${SEGMENT_SIZE:-16}
MAX_STEPS=${MAX_STEPS:-20}
TIME_LIMIT=${TIME_LIMIT:-04:00:00}
DEFAULT_DEEPEP_COMMIT=f725d29699f5bda9ba789456bb9579af69844685
